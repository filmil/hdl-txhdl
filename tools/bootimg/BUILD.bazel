# The boot image: the shim, OpenSBI, the device tree, the kernel and the
# initramfs as one blob for fastboot (issue 1019).
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "bootimg",
    srcs = ["main.rs"],
    edition = "2021",
)

# The layout's rules, and the image booting in the machine model.
rust_test(
    name = "bootimg_test",
    srcs = ["main.rs"],
    edition = "2021",
    deps = ["//cpu/vreteno:vreteno32"],
)

load(":defs.bzl", "boot_image")

# The rule end to end on stand-ins, so a change to any step is built
# before the real kernel and initramfs exist on main.
boot_image(
    name = "sample",
    bootargs = "earlycon=sbi console=ttySIF0",
    initramfs = "testdata/initramfs.cpio",
    kernel = "testdata/Image",
    opensbi = "testdata/opensbi.bin",
    system_map = "testdata/System.map",
)
