# SPDX-License-Identifier: Apache-2.0
#
# Draws the project's timeline as a TikZ picture, from the data
# `//tools/timeline` extracted from the repository's own history.
load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "gantt",
    srcs = ["main.rs"],
    edition = "2021",
)
