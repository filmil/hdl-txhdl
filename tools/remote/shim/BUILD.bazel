#
# The shim beside the board: raw frames off the interface the board is
# wired to, onto the stream `//tools/remote` speaks, and back. It runs
# on the machine with the board, as root or with cap_net_raw.
#
#   bazel build //tools/remote/shim && scp bazel-bin/tools/remote/shim/shim_/shim board:
#   shim -iface enp3s0 -listen :9797
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "shim_lib",
    srcs = [
        "main.go",
        "packet_linux.go",
        "shim.go",
    ],
    importpath = "github.com/filmil/txhdl/tools/remote/shim",
    deps = ["//tools/remote/stream"],
)

go_binary(
    name = "shim",
    embed = [":shim_lib"],
    pure = "on",
)

# The pump against a wire in memory and a stream in memory: what
# arrives on the wire reaches the stream with its length in front, a
# foreign frame does not, an answer on the stream leaves on the wire
# as it was, and either side ending ends the pump.
go_test(
    name = "shim_test",
    srcs = ["shim_test.go"],
    embed = [":shim_lib"],
    deps = ["//tools/remote/stream"],
)

# Puts the shim on the machine the board is wired to, as a systemd
# service that is given CAP_NET_RAW at launch: the binary and a unit
# filled in for that machine go to ~/txhdl_shim there, and the lines
# the user runs once as root are printed, ending in the checks. Manual,
# since it reaches the board's machine.
#
#   bazel run //tools/remote/shim:deploy -- --dry-run
#   bazel run //tools/remote/shim:deploy
sh_binary(
    name = "deploy",
    srcs = ["deploy.sh"],
    data = [
        "txhdl-shim.service.in",
        ":shim",
        "@bazel_tools//tools/bash/runfiles",
    ],
    tags = ["manual"],
)
