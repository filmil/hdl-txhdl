# The generated half of the datasheets, and the check that every
# component has a datasheet.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Every component's parameters, ports, state and children, as LaTeX.
rust_binary(
    name = "datasheet",
    srcs = ["main.rs"],
    edition = "2021",
    deps = [
        "//cpu/vreteno:vreteno32",
        "//ddr3",
        "//gpu/razboj",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
        "//pcie",
    ],
)

genrule(
    name = "tables",
    outs = ["ds_tables.tex"],
    cmd = "$(location :datasheet) > $@",
    tools = [":datasheet"],
)

# Every lowered unit in the crates below, and every family a macro
# writes, has a datasheet that says it covers it. A crate that gains
# lowered units adds its sources here.
#
# Manual: a change that adds a component files an issue for its sheet
# rather than writing one, so this test is the sweep's own check and
# not a step of `bazel test //...`:
#
#   bazel test //tools/datasheet:coverage_test
sh_test(
    name = "coverage_test",
    srcs = ["coverage_test.sh"],
    tags = ["manual"],
    data = [
        "//cpu/vreteno:sources",
        "//ddr3:sources",
        "//docs:datasheet_sources",
        "//gpu/razboj:sources",
        "//pcie:sources",
        "//lib/parts:sources",
    ],
)

# Every row of every generated table is on a page of the datasheets
# (issue 1614): a table LaTeX cannot break runs off its page, and the
# rows past the edge are set on no page at all, which //docs:edge_test
# cannot see.
rust_binary(
    name = "whole",
    srcs = ["whole.rs"],
    edition = "2021",
)

rust_test(
    name = "whole_unit_test",
    crate = ":whole",
    edition = "2021",
)

sh_test(
    name = "tables_whole_test",
    srcs = ["tables_whole_test.sh"],
    args = [
        "$(rootpath :whole)",
        "$(rootpath :tables)",
        "$(rootpath //docs:datasheets)",
    ],
    data = [
        ":tables",
        ":whole",
        "//docs:datasheets",
        "//third_party/poppler:tree",
    ],
)
