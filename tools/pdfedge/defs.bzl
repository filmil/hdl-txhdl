"""A test that every word of a set of rendered documents lies on its page.

`pdf_edge_test(name, pdfs)` runs //tools/pdfedge over the documents'
PDFs with `pdftotext` from the pinned tree in //third_party/poppler,
and fails naming the document, the page and the word whose box ends
past the page's edge (issue 457). LaTeX reports no overfull box a
reader would recognise for a table wider than its column, and the
waveform width test reads TikZ coordinates rather than pages, so this
is the check that sees the page as the reader does.
"""

def _tree_root(files, suffix):
    """The runfiles path of the tree that holds a file ending in `suffix`."""
    for f in files:
        if f.short_path.endswith(suffix):
            return f.short_path[:-len(suffix)]
    fail("no file ending in %s among %d files" % (suffix, len(files)))

def _pdf_edge_test_impl(ctx):
    tree = ctx.attr.tree[DefaultInfo].files.to_list()
    root = _tree_root(tree, "/usr/bin/pdftotext")
    pdfs = []
    for target in ctx.attr.pdfs:
        pdfs += target[DefaultInfo].files.to_list()
    script = ctx.actions.declare_file(ctx.label.name + ".sh")
    ctx.actions.write(
        output = script,
        is_executable = True,
        content = "\n".join([
            "#!/usr/bin/env bash",
            "# Generated by //tools/pdfedge:defs.bzl.",
            "set -euo pipefail",
            'exec "%s" --pdftotext "%s/usr/bin/pdftotext" --slack %s %s' % (
                ctx.executable.tool.short_path,
                root,
                ctx.attr.slack,
                " ".join(['"%s"' % f.short_path for f in pdfs]),
            ),
            "",
        ]),
    )
    runfiles = ctx.runfiles(files = pdfs + tree).merge(
        ctx.attr.tool[DefaultInfo].default_runfiles,
    )
    return [DefaultInfo(executable = script, runfiles = runfiles)]

pdf_edge_test = rule(
    implementation = _pdf_edge_test_impl,
    test = True,
    doc = "Fails when a word of any of the documents lies past its page's edge.",
    attrs = {
        "pdfs": attr.label_list(
            allow_files = [".pdf"],
            mandatory = True,
            doc = "The documents, as the targets that render them.",
        ),
        "slack": attr.string(
            default = "0",
            doc = "How far past the edge a word may end, in points.",
        ),
        "tool": attr.label(
            default = "//tools/pdfedge",
            executable = True,
            cfg = "exec",
        ),
        "tree": attr.label(
            default = "//third_party/poppler:tree",
            doc = "The pinned tree that holds usr/bin/pdftotext.",
        ),
    },
)
