# PCIe on the Alinx AX7A200B: AMD's XDMA endpoint in AXI bridge mode,
# generated by the build, and the lowered design behind its BAR0.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load(
    "@rules_vivado//build/vivado:rules.bzl",
    "vivado_ip",
    "vivado_place_and_route2",
)
load("//tools/vivado:defs.bzl", "vivado_synthesis2")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "pcie",
    srcs = [
        "src/bar.rs",
        "src/lib.rs",
    ],
    crate_name = "pcie",
    edition = "2021",
    proc_macro_deps = ["//lib:txhdl_macros"],
    deps = [
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
)

# The design behind BAR0, driven through the endpoint's pins in Rust.
rust_test(
    name = "bar_test",
    srcs = ["tests/bar.rs"],
    edition = "2021",
    deps = [
        ":pcie",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
)

# Its Verilog, for the board's top.
rust_binary(
    name = "bar_netlist",
    srcs = ["src/bin/bar_netlist.rs"],
    edition = "2021",
    deps = [":pcie"],
)

genrule(
    name = "bar_v",
    outs = ["pcie_bar.v"],
    cmd = "$(location :bar_netlist) > $@",
    tools = [":bar_netlist"],
)

# The endpoint: XDMA in AXI bridge mode, Gen2 over the board's two
# lanes, from the slot's 100 MHz reference clock, with BAR0 a megabyte
# of memory on the AXI master and no AXI slave. Its user clock is
# 125 MHz, which is the only one Gen2 x2 allows. Manual, as every Vivado
# target is:
#
#   bazel build //pcie:xdma_x2
vivado_ip(
    name = "xdma_x2",
    config = {
        "functional_mode": "AXI_Bridge",
        "mode_selection": "Advanced",
        "pl_link_cap_max_link_speed": "5.0_GT/s",
        "pl_link_cap_max_link_width": "X2",
        "ref_clk_freq": "100_MHz",
        "axi_data_width": "64_bit",
        "axi_addr_width": "32",
        "axisten_freq": "125",
        "en_axi_slave_if": "false",
        "pf0_bar0_scale": "Megabytes",
        "pf0_bar0_size": "1",
    },
    part = "xc7a200tfbg484-2",
    tags = ["manual"],
    vlnv = "xilinx.com:ip:xdma:4.2",
)

filegroup(
    name = "endpoint_xdc",
    srcs = ["board/ax7a200_pcie.xdc"],
)

# The endpoint and the design behind it, through Vivado's synthesis and
# then place and route with the board's pins to a bitstream:
#
#   bazel build //pcie:endpoint_synth
#   bazel build //pcie:endpoint_pnr
vivado_synthesis2(
    name = "endpoint_synth",
    srcs = [
        ":bar_v",
        "board/pcie_top.v",
    ],
    part = "xc7a200tfbg484-2",
    top = "pcie_top",
    xdcs = [":endpoint_xdc"],
    deps = [":xdma_x2"],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "endpoint_pnr",
    synthesis = ":endpoint_synth",
    xdcs = [":endpoint_xdc"],
    tags = ["manual"],
)

# The sources by name, for the documents' listings.
filegroup(
    name = "sources",
    srcs = glob([
        "board/*.v",
        "board/*.xdc",
        "src/*.rs",
        "src/bin/*.rs",
        "tests/*.rs",
    ]),
)
