# Verilog a board design of any area wants: the pieces that are not
# lowered from Rust because they are about clocks and pads rather than
# about what the design computes, and that more than one area needs.
package(default_visibility = ["//visibility:public"])

# A lowered unit's channel, carried from one clock to another.
filegroup(
    name = "chan_cdc",
    srcs = ["chan_cdc.v"],
)

# The sources by name, for the documents' listings.
filegroup(
    name = "sources",
    srcs = glob(["*.v"]),
)

# The USER4 scan chain for the RISC-V debug transport (issue 154), and
# the constraint that makes its clock one of its own.
filegroup(
    name = "bscan_user4",
    srcs = ["bscan_user4.v"],
)

exports_files(["bscan_user4.xdc"])
