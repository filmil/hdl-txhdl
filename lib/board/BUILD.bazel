# SPDX-License-Identifier: Apache-2.0
# Verilog a board design of any area wants: the pieces that are not
# lowered from Rust because they are about clocks and pads rather than
# about what the design computes, and that more than one area needs.
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

package(default_visibility = ["//visibility:public"])

# A lowered unit's channel, carried from one clock to another.
filegroup(
    name = "chan_cdc",
    srcs = ["chan_cdc.v"],
)

# The sources by name, for the documents' listings.
filegroup(
    name = "sources",
    srcs = glob(["*.v"]),
)

# The USER4 scan chain for the RISC-V debug transport (issue 154), and
# the constraint that makes its clock one of its own.
filegroup(
    name = "bscan_user4",
    srcs = ["bscan_user4.v"],
)

exports_files(["bscan_user4.xdc"])

# chan_cdc's resets, released in either order and alone (issue 1325),
# under the hermetic Verilator, as //tools/vlcheck runs a testbench.
verilog_library(
    name = "chan_cdc_tb_v",
    srcs = [
        "chan_cdc.v",
        "chan_cdc_tb.v",
    ],
    top_module = "chan_cdc_tb",
)

verilator_cc_library(
    name = "chan_cdc_tb_verilated",
    module = ":chan_cdc_tb_v",
    copts = ["-Wno-sign-compare"],
    timing = True,
    vopts = [
        "--main",
        "-Wno-fatal",
    ],
)

cc_test(
    name = "chan_cdc_test",
    srcs = ["//tools/vlcheck:main.cc"],
    deps = [":chan_cdc_tb_verilated"],
)
