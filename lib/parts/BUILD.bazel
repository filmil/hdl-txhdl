# SPDX-License-Identifier: Apache-2.0
# Parts: units the language provides as hardware, written in the
# language's own lowerable subset. The channel buffer is the first.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/vivado:defs.bzl", "vivado_synthesis2")

rust_library(
    name = "txhdl_parts",
    srcs = [
        "src/buffer.rs",
        "src/eth.rs",
        "src/ethdma.rs",
        "src/ethslots.rs",
        "src/bus/axi.rs",
        "src/bus/axi_lite.rs",
        "src/bus/axi_pins.rs",
        "src/bus/noc.rs",
        "src/bus/noc/bridge.rs",
        "src/bus/noc/mesh.rs",
        "src/bus/noc/node.rs",
        "src/bus/noc/pkt.rs",
        "src/bus/noc/switch.rs",
        "src/bus/axi/fuzz.rs",
        "src/bus/axi/sim.rs",
        "src/bus/mod.rs",
        "src/bus/arbiter.rs",
        "src/bus/router.rs",
        "src/bus/wb.rs",
        "src/bus/wb/sim.rs",
        "src/cdc.rs",
        "src/dma.rs",
        "src/fifo.rs",
        "src/flashwin.rs",
        "src/gpio.rs",
        "src/hdmi.rs",
        "src/i2c.rs",
        "src/plic.rs",
        "src/pwm.rs",
        "src/redundant.rs",
        "src/remote.rs",
        "src/remote/eth.rs",
        "src/spi.rs",
        "src/station.rs",
        "src/tracer.rs",
        "src/syscon.rs",
        "src/wdog.rs",
        "src/lib.rs",
    ],
    crate_name = "txhdl_parts",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = ["//lib:txhdl"],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

# The crate's own tests: a unit in a plain #[test].
rust_test(
    name = "parts_test",
    crate = ":txhdl_parts",
    edition = "2021",
)

# The AXI link's fuzzing alone, over many more seeds than the 24 that
# `parts_test` runs: what the nightly release runs. Manual, since it is
# a long run.
#
#   bazel test //lib/parts:axi_fuzz_test --test_env=AXI_FUZZ_SEEDS=512
rust_test(
    name = "axi_fuzz_test",
    args = ["bus::axi::fuzz::"],
    crate = ":txhdl_parts",
    edition = "2021",
    tags = ["manual"],
)

# The sources by name, for the documents' API extraction.
exports_files(glob(["src/*.rs", "src/bus/*.rs", "src/bus/axi/*.rs", "src/bus/noc/*.rs", "src/bus/wb/*.rs"]))

filegroup(
    name = "sources",
    srcs = glob(["src/*.rs", "src/bus/*.rs", "src/bus/axi/*.rs", "src/bus/noc/*.rs", "src/bus/wb/*.rs"]),
    visibility = ["//visibility:public"],
)

# The Verilog of one node, and of one switch inside it, for a synthesis
# run that says how fast a node can go and what it costs (issue 99).
#
#   bazel run //lib/parts:noc_netlist -- switch
rust_binary(
    name = "noc_netlist",
    srcs = ["src/bin/noc_netlist.rs"],
    edition = "2021",
    deps = [":txhdl_parts"],
)

genrule(
    name = "node_v",
    outs = ["node.v"],
    cmd = "$(location :noc_netlist) node > $@",
    tools = [":noc_netlist"],
)

genrule(
    name = "switch_v",
    outs = ["switch.v"],
    cmd = "$(location :noc_netlist) switch > $@",
    tools = [":noc_netlist"],
)

filegroup(
    name = "noc_xdc",
    srcs = ["noc.xdc"],
)

# One node and one switch through Vivado, for the timing and the
# utilisation issue 99 asks for. Manual, as every Vivado target here
# is.
#
#   bazel build //lib/parts:node_synth
vivado_synthesis2(
    name = "node_synth",
    srcs = [":node.v"],
    part = "xc7a200tfbg484-2",
    tags = ["manual"],
    top = "node",
    xdcs = [":noc_xdc"],
)

vivado_synthesis2(
    name = "switch_synth",
    srcs = [":switch.v"],
    part = "xc7a200tfbg484-2",
    tags = ["manual"],
    top = "switch",
    xdcs = [":noc_xdc"],
)
