# SPDX-License-Identifier: Apache-2.0
# Parts: units the language provides as hardware, written in the
# language's own lowerable subset. The channel buffer is the first.
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "txhdl_parts",
    srcs = [
        "src/buffer.rs",
        "src/eth.rs",
        "src/bus/axi.rs",
        "src/bus/axi_lite.rs",
        "src/bus/noc.rs",
        "src/bus/noc/bridge.rs",
        "src/bus/noc/mesh.rs",
        "src/bus/noc/node.rs",
        "src/bus/noc/pkt.rs",
        "src/bus/noc/switch.rs",
        "src/bus/axi/sim.rs",
        "src/bus/mod.rs",
        "src/bus/router.rs",
        "src/bus/wb.rs",
        "src/bus/wb/sim.rs",
        "src/fifo.rs",
        "src/gpio.rs",
        "src/hdmi.rs",
        "src/plic.rs",
        "src/station.rs",
        "src/lib.rs",
    ],
    crate_name = "txhdl_parts",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = ["//lib:txhdl"],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

# The crate's own tests: a unit in a plain #[test].
rust_test(
    name = "parts_test",
    crate = ":txhdl_parts",
    edition = "2021",
)

# The sources by name, for the documents' API extraction.
exports_files(glob(["src/*.rs", "src/bus/*.rs", "src/bus/axi/*.rs", "src/bus/noc/*.rs", "src/bus/wb/*.rs"]))

filegroup(
    name = "sources",
    srcs = glob(["src/*.rs", "src/bus/*.rs", "src/bus/axi/*.rs", "src/bus/noc/*.rs", "src/bus/wb/*.rs"]),
    visibility = ["//visibility:public"],
)
