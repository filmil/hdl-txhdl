#
# One compiled example per concept in the runtime. The article's appendix
# includes each file verbatim, so a listing there is also a build target
# here, and a concept with no example is a concept nobody has checked.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

package(default_visibility = ["//visibility:public"])

EXAMPLES = [
    "ex_values",
    "ex_transaction",
    "ex_interface",
    "ex_unit",
    "ex_pipeline",
    "ex_clock",
    "ex_hierarchy",
]

[
    rust_library(
        name = name,
        srcs = [name + ".rs"],
        edition = "2021",
        deps = ["//lib:txhdl"],
        proc_macro_deps = ["//lib:txhdl_macros"],
    )
    for name in EXAMPLES
]

# A design is a program:  bazel run //lib/examples:ex_config -- asic
rust_binary(
    name = "ex_config",
    srcs = ["ex_config.rs"],
    edition = "2021",
    deps = ["//lib:txhdl"],
)

# Blinky:  bazel run //lib/examples:ex_blinky
rust_binary(
    name = "ex_blinky",
    srcs = ["ex_blinky.rs"],
    edition = "2021",
    deps = ["//lib:txhdl"],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

# A state machine:  bazel run //lib/examples:ex_case
rust_binary(
    name = "ex_case",
    srcs = ["ex_case.rs"],
    edition = "2021",
    deps = ["//lib:txhdl"],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

# An asynchronous FIFO between two clocks:  bazel run //lib/examples:ex_fifo
rust_binary(
    name = "ex_fifo",
    srcs = ["ex_fifo.rs"],
    edition = "2021",
    deps = ["//lib:txhdl"],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

filegroup(
    name = "sources",
    srcs = [n + ".rs" for n in EXAMPLES] + ["ex_config.rs", "ex_blinky.rs", "ex_case.rs", "ex_fifo.rs"],
)
