# The stage's own Verilog, from its lowering, made a unit again by
# Verilator; the example co-runs the two:  bazel run //lib/examples:ex_foreign
genrule(
    name = "stage_v",
    outs = ["stage.v"],
    cmd = "TXHDL_VERILOG=$@ $(location :ex_stage) > /dev/null",
    tools = [":ex_stage"],
)

verilog_unit(
    name = "stage_verilog",
    src = ":stage.v",
    top = "stage",
)

# The stage's VHDL, the same way, with nvc as a child process.
genrule(
    name = "stage_vhd",
    outs = [
        "stage.vhd",
        "stage.vhd.ports",
    ],
    cmd = "TXHDL_VHDL=$(location stage.vhd) $(location :ex_stage) > /dev/null",
    tools = [":ex_stage"],
)

vhdl_unit(
    name = "stage_vhdl",
    src = ":stage.vhd",
    entity = "stage",
)

rust_binary(
    name = "ex_foreign",
    srcs = ["ex_foreign.rs"],
    edition = "2021",
    deps = [
        ":stage_verilog",
        ":stage_vhdl",
        "//lib:txhdl",
    ],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

