# The Utah teapot as data (#1592): Newell's control points and patches,
# as freeglut's header holds them, which MODULE.bazel fetches by
# checksum and //tools/teapot2rs turns into Rust at build time. The
# generated file carries the header's notice.
#
# The crate holds data and nothing else, so it builds for the core as
# readily as for this machine, as //lib/logo's does.
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "teapot_data_rs",
    srcs = ["@freeglut_teapot_data_h//file"],
    outs = ["teapot_data.rs"],
    cmd = "$(execpath //tools/teapot2rs) $< $@",
    tools = ["//tools/teapot2rs"],
)

rust_library(
    name = "teapot_data",
    srcs = [":teapot_data_rs"],
    crate_name = "teapot_data",
    crate_root = ":teapot_data_rs",
    edition = "2021",
)
