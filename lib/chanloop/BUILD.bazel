# SPDX-License-Identifier: Apache-2.0
# Two lowered units joined wire to wire in a Verilog top deadlock when
# the sender's valid waits on its ready and the receiver's ready on its
# valid (#1868); joined by TxHDL's own channel they do not.
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_nvc//nvc:rules.bzl", "vhdl_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

rust_binary(
    name = "gen",
    srcs = ["gen.rs"],
    edition = "2021",
    deps = ["//lib:txhdl"],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

# The rule for a top is in the header of each module with a channel.
rust_test(
    name = "header_test",
    crate = ":gen",
    edition = "2021",
)

genrule(
    name = "netlists",
    outs = ["count.v", "stage.v", "pair.v", "pair_u.v", "pair_u.vhd", "axi_count.v"],
    cmd = "$(location :gen) $(OUTS)",
    tools = [":gen"],
)


# Joined wire to wire: no word passes (#1868).
verilog_library(
    name = "direct_vl",
    srcs = ["count.v", "stage.v", "direct_tb.v"],
    top_module = "direct_tb",
)

# -Wno-fatal: Verilator flags the direct join's loop as circular
# logic, which is the hazard itself.
verilator_cc_library(
    name = "direct_verilated",
    module = ":direct_vl",
    copts = ["-Wno-sign-compare"],
    timing = True,
    vopts = ["--main", "-Wno-fatal"],
)

cc_test(
    name = "direct_vsim_test",
    srcs = ["//tools/vlcheck:main.cc"],
    deps = [":direct_verilated"],
)

# The sender marked `#[axi]`, joined wire to wire: every word passes,
# in order (#1871).
verilog_library(
    name = "direct_axi_vl",
    srcs = ["axi_count.v", "stage.v", "direct_axi_tb.v"],
    top_module = "direct_axi_tb",
)

verilator_cc_library(
    name = "direct_axi_verilated",
    module = ":direct_axi_vl",
    copts = ["-Wno-sign-compare"],
    timing = True,
    vopts = ["--main"],
)

cc_test(
    name = "direct_axi_vsim_test",
    srcs = ["//tools/vlcheck:main.cc"],
    deps = [":direct_axi_verilated"],
)

# Joined by TxHDL's own channel: every word passes, in order.
verilog_library(
    name = "buffered_vl",
    srcs = ["pair.v", "buffered_tb.v"],
    top_module = "buffered_tb",
)

# No -Wno-fatal here: a loop or a width warning in pair_txhdl_chan
# fails the build.
verilator_cc_library(
    name = "buffered_verilated",
    module = ":buffered_vl",
    copts = ["-Wno-sign-compare"],
    timing = True,
    vopts = ["--main"],
)

cc_test(
    name = "buffered_vsim_test",
    srcs = ["//tools/vlcheck:main.cc"],
    deps = [":buffered_verilated"],
)

# Both channel buffers under a sender that does not wait for ready, as
# AXI requires: each word passes once, in order (#1871).
verilog_library(
    name = "offer_vl",
    srcs = ["pair_u.v", "offer_tb.v"],
    top_module = "offer_tb",
)

verilator_cc_library(
    name = "offer_verilated",
    module = ":offer_vl",
    copts = ["-Wno-sign-compare"],
    timing = True,
    vopts = ["--main"],
)

cc_test(
    name = "offer_vsim_test",
    srcs = ["//tools/vlcheck:main.cc"],
    deps = [":offer_verilated"],
)

vhdl_test(
    name = "offer_sim_test",
    srcs = ["pair_u.vhd", "offer_tb.vhd"],
    deps = [],
    entities = ["offer_tb"],
)
