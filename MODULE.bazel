# SPDX-License-Identifier: Apache-2.0
module(
    name = "txhdl",
    version = "0.0.0",
)

# LaTeX, from the custom registry named in .bazelrc. The module registers a
# `system` toolchain that shells out to the host's pdflatex; the hermetic
# toolchain declared below is registered by this root module and therefore
# wins, so the build needs nothing installed on the machine.
bazel_dep(name = "rules_latex_host", version = "0.3.0")

hermetic_latex = use_extension(
    "@rules_latex_host//latex:extensions.bzl",
    "hermetic_latex",
)

# The pinned TinyTeX distribution carries neither IEEEtran nor the drawing
# packages, and the obvious fix does not work here. `texlive_archives` pins a
# package archive by sha256, but texlive.info answers Bazel with a different
# byte stream on every request (the hash changed on each of two consecutive
# fetches, while curl returned identical bytes each time), so no pin can
# match. IEEEtran.cls and IEEEtrantools.sty are therefore vendored next to
# the document and passed through `data`, which the ruleset documents as the
# way to supply a class or style file. That removes the fetch entirely.
hermetic_latex.toolchain()
use_repo(hermetic_latex, "hermetic_latex", "hermetic_latex_ghostscript")

register_toolchains("@hermetic_latex//:all")

# Rust, so that claims about what the language can express are compiled
# rather than argued. docs/rust-embedding.md section 8 lists what is being
# checked. The toolchain is fetched by the ruleset, so nothing is installed
# on the machine.
# The constraint values a platform is written in: the CPU Vreteno is,
# and the absence of an operating system.
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "rules_rust", version = "0.74.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # The bare-metal RISC-V target Vreteno is: thirty-two bit, the
    # multiply extension, compressed instructions, no operating
    # system. Naming it here makes the build fetch that target's
    # standard library by checksum, as it fetches the host's, so
    # nothing has to be installed to compile for the core.
    extra_target_triples = ["riscv32imc-unknown-none-elf"],
    versions = [
        # Stable and nightly both, because the open question is which of
        # the two the numeric library needs.
        "1.90.0",
        "nightly/2026-08-01",
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# A C and C++ compiler for Vreteno itself, fetched by checksum: the
# xPack build of the GNU toolchain for bare-metal RISC-V. It is here
# rather than a Clang because of what comes with it. Its `rv32imc/ilp32`
# multilib is exactly this core, RV32IMC with the soft-float ABI, and
# it carries newlib and a
# real `libstdc++.a` built for it, so "with a standard library" is
# something the toolchain already has rather than something the build
# would have to compile.
http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_archive(
    name = "riscv_none_elf_gcc",
    build_file = "//third_party/riscv_gcc:BUILD.toolchain",
    sha256 = "f574415b63f12b09bdd3475223ab492a465d23810646c90c13a4c3b676c83503",
    strip_prefix = "xpack-riscv-none-elf-gcc-14.2.0-3",
    urls = [
        "https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v14.2.0-3/xpack-riscv-none-elf-gcc-14.2.0-3-linux-x64.tar.gz",
    ],
)

# Prebuilt tools, fetched by checksum for every platform they ship for.
# vcdcvt and sqlite2drawtiming turn a VCD into a signals database and
# the database into drawtiming text; //tools/dt2tikz draws that text.
bazel_dep(name = "rules_multitool", version = "1.11.1")

# 1.11.1 reports every module's multitool hub as a direct dependency
# of the root, so rules_bid's hub, reached through rules_vivado, made
# every build warn (issue 534). Upstream fixed it in v1.12.0, which the
# registry does not have yet; the patch is that fix alone. Drop this
# when the registry has 1.12.0.
single_version_override(
    module_name = "rules_multitool",
    patch_strip = 1,
    patches = ["//third_party:rules_multitool_root_hubs.patch"],
    version = "1.11.1",
)

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

# The one external crate: an FST writer, so a waveform is a compressed
# binary the tools read as they read VCD. Pinned by a lockfile;
# `CARGO_BAZEL_REPIN=1 bazel sync --only=crates` regenerates it.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "fst-writer",
    version = "0.3.1",
)
# The reference reader, for checking what the writer wrote.
crate.spec(
    package = "wellen",
    version = "0.25.6",
)
crate.from_specs(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
)
use_repo(crate, "crates")

# VHDL simulation, hermetic (nvc is built from source through the
# registry): the lowered designs are simulated against the traces the Rust
# simulation wrote.
bazel_dep(name = "rules_nvc", version = "4.5.2")

# Verilog simulation, hermetic (Verilator is built from source through the
# registry): the same lowered designs, as Verilog, are simulated against
# the same traces, so both emitters are checked.
bazel_dep(name = "rules_verilator", version = "1.1.2")
bazel_dep(name = "rules_verilog", version = "1.4.3")
bazel_dep(name = "rules_cc", version = "0.2.22")

# Verilator comes down as a binary rather than being compiled here.
# Building it from source is about six minutes on a machine that has
# not done it before, and it is the same binary everywhere, so it is
# built once by `filmil/bazel_toolchains_verilator` and downloaded by
# everybody. The rules are still `rules_verilator`'s; only where the
# binary comes from changes.
bazel_dep(name = "bazel_toolchains_verilator", version = "0.1.0")

verilator_binary = use_extension(
    "@bazel_toolchains_verilator//verilator:extension.bzl",
    "verilator_binary",
)
use_repo(verilator_binary, "verilator_prebuilt")

register_toolchains("@verilator_prebuilt//:toolchain")

# Synthesis, hermetic: rules_vivado installs Vivado itself, from the AMD
# installer archive named here, into a shared install cache, and every
# workspace on the machine reuses that one installation. AMD's download
# needs a login, so the archive is served from a local path; `.bazelrc`
# selects the mode. A cold install moves the archive three times and
# needs about 300 GB free at its peak, see the ruleset's
# docs/vivado-toolchain.md; a warm cache is found in seconds. The cache
# key is the URL and the selection with no `sha256`, exactly as the
# other workspaces on this machine state them, so that the key matches
# theirs and the installation is shared rather than redone.
bazel_dep(name = "rules_vivado", version = "3.13.0")
# Shell binaries: the remote programmer and the serial watcher.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Go, for the serial watcher that runs on the board's machine: one
# static binary, uploaded, with the standard library alone.
bazel_dep(name = "rules_go", version = "0.61.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.1")

vivado = use_extension("@rules_vivado//:extensions.bzl", "vivado")
vivado.install(
    install_cache = "/data/cache/vivado-install",
    urls = ["file:///data/tools/archives/FPGAs_AdaptiveSoCs_Unified_SDI_2025.2_1114_2157_1.tar"],
    modules = ["Artix-7"],
)

# The ASIC flow, hermetic in the same sense as the rest: nothing is
# installed, everything is fetched by checksum. Yosys maps the core's
# Verilog onto a standard cell library and OpenROAD floorplans, places,
# routes and times it. Both are published as Debian packages, and a
# Debian package names the shared libraries it needs without carrying
# them, so //tools/debclosure writes the closure of each as a lock file
# in //third_party and the rule below unpacks exactly those bytes.
# Bazel's own decompressors open both the `ar` archive a `.deb` is and
# the `tar.xz` inside it, so neither `dpkg` nor a container is used.
deb_tree = use_repo_rule("//third_party/debs:repo.bzl", "deb_tree")

file_tree = use_repo_rule("//third_party/debs:repo.bzl", "file_tree")

deb_tree(
    name = "yosys_tree",
    locks = ["//third_party/yosys:trixie.lock.tsv"],
)

deb_tree(
    name = "openroad_tree",
    locks = [
        "//third_party/openroad:openroad.lock.tsv",
        "//third_party/openroad:bullseye.lock.tsv",
    ],
)

# Poppler's `pdftotext`, which reads a rendered page back with the
# position of every word, for the check that no document runs off its
# page (issue 457).
deb_tree(
    name = "poppler_tree",
    locks = ["//third_party/poppler:trixie.lock.tsv"],
)

# The SMT solver SymbiYosys's bounded search and cover runs use
# (issue 581). The unbounded proof runs inside yosys-abc and needs no
# solver.
deb_tree(
    name = "z3_tree",
    locks = ["//third_party/z3:trixie.lock.tsv"],
)

# SymbiYosys, the front end that drives Yosys through a formal proof
# (issue 581). Pure Python, packaged by no Debian suite, so fetched from
# its release tag; v0.52 matches the Yosys 0.52 of //third_party/yosys.
# ISC. //third_party/sby installs it.
http_archive(
    name = "sby",
    build_file_content = """
exports_files(glob(["sbysrc/*.py"]))
""",
    sha256 = "8c14bcd6130a8db94764abc650046bf9986a4a5bbea662a03481ba546b6df5e0",
    strip_prefix = "sby-0.52",
    urls = ["https://github.com/YosysHQ/sby/archive/refs/tags/v0.52.tar.gz"],
)

# The solver OpenROAD's global placer uses. The package links against
# it and does not carry it: its runpath names `/opt/or-tools`, which is
# where the project's own build puts this archive.
http_archive(
    name = "or_tools",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
filegroup(name = "all", srcs = glob(["lib/**"]))
""",
    sha256 = "a8354696f365aa13a2375da5f8f6cfd8785430681addcd887bfd194851dd4710",
    strip_prefix = "or-tools_x86_64_Debian-11_cpp_v9.11.4210",
    urls = [
        "https://github.com/google/or-tools/releases/download/v9.11/or-tools_amd64_debian-11_cpp_v9.11.4210.tar.gz",
    ],
)

# The technology: the open 45 nm library the OpenROAD project uses for
# its own examples, taken file by file from the flow scripts at one
# revision.
file_tree(
    name = "nangate45",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
filegroup(name = "all", srcs = glob(["tree/**"]))
""",
    locks = ["//third_party/nangate45:nangate45.lock.tsv"],
)

# Zephyr, and what its build needs, so that the port under `//zephyr`
# is compiled by this build rather than by a reader following a README
# (issue 390).
#
# Nothing here is used by any other target. The cost is a cold build's
# fetches, about ninety megabytes of Zephyr and rather less of the
# rest; the gain is that a device tree which does not parse, a Kconfig
# symbol that does not exist, or a driver that does not compile fails
# `bazel test //...` instead of waiting for somebody to try it. That
# port shipped four faults of exactly those kinds, every one of them
# leaving a green build, before it ever printed on a board.
#
# Python is here because Zephyr's build generates its headers with
# Python and there is no way to have the one without the other. It is
# a vendored toolchain rather than a language this repository writes
# in: nothing under `//tools` becomes Python because of this.
bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_dtc", version = "0.0.5")
bazel_dep(name = "dtc", version = "1.7.2.bcr.1")

# `flex` is pinned rather than resolved. The default resolution takes
# `2.6.4.bcr.2`, on which building `dtc` fails with `config.h:208:
# expected expression before '/'` and a `strrchr` called with too few
# arguments.
bazel_dep(name = "flex", version = "2.6.4.bcr.6")
bazel_dep(name = "ninja", version = "1.13.2")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(is_default = True, python_version = "3.12")
use_repo(python, "python_3_12_host")

# The devicetree tooling Zephyr's build imports. The closure is listed
# and not just the four packages that are named in Zephyr's own
# documentation: `rules_python` installs what it is given and nothing
# else, so a missing transitive dependency is a `No module named` at
# the end of a configure rather than at the start of one.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "zephyr_py",
    python_version = "3.12",
    requirements_lock = "//third_party/zephyr:requirements.txt",
)
use_repo(pip, "zephyr_py")

# SymbiYosys imports `click` and nothing else beyond the standard
# library; the lock beside its BUILD file pins it by hash (issue 581).
pip.parse(
    hub_name = "formal_py",
    python_version = "3.12",
    requirements_lock = "//third_party/sby:requirements.txt",
)
use_repo(pip, "formal_py")

# CMake, prebuilt and by checksum, as the RISC-V compiler above is.
# Zephyr drives its build with CMake, so what is wanted is the binary
# rather than a library rule.
http_archive(
    name = "cmake_host",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
filegroup(name = "cmake", srcs = ["bin/cmake"])
filegroup(name = "all", srcs = glob(["**"]))
""",
    sha256 = "5a1133ff103c71eb5120e2cc3de922733e7d8a26a98ae716397e8676adb367bf",
    strip_prefix = "cmake-3.31.6-linux-x86_64",
    urls = [
        "https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6-linux-x86_64.tar.gz",
    ],
)

# Zephyr itself, at the release the port was written against. The
# module under `//zephyr` is pointed at this tree rather than vendored
# into it, which is the same arrangement a reader gets with `west`.
http_archive(
    name = "zephyr",
    build_file = "//third_party/zephyr:zephyr.BUILD.bazel",
    sha256 = "b98623e68d9eb220331ad7447ceae465673a3538704d94add30ac3b66721f992",
    strip_prefix = "zephyr-4.1.0",
    urls = [
        "https://github.com/zephyrproject-rtos/zephyr/archive/refs/tags/v4.1.0.tar.gz",
    ],
)
