# SPDX-License-Identifier: Apache-2.0
module(
    name = "txhdl",
    version = "0.0.0",
)

# LaTeX, from the custom registry named in .bazelrc. The module registers a
# `system` toolchain that shells out to the host's pdflatex; the hermetic
# toolchain declared below is registered by this root module and therefore
# wins, so the build needs nothing installed on the machine.
bazel_dep(name = "rules_latex_host", version = "0.3.0")

hermetic_latex = use_extension(
    "@rules_latex_host//latex:extensions.bzl",
    "hermetic_latex",
)

# The pinned TinyTeX distribution carries neither IEEEtran nor the drawing
# packages, and the obvious fix does not work here. `texlive_archives` pins a
# package archive by sha256, but texlive.info answers Bazel with a different
# byte stream on every request (the hash changed on each of two consecutive
# fetches, while curl returned identical bytes each time), so no pin can
# match. IEEEtran.cls and IEEEtrantools.sty are therefore vendored next to
# the document and passed through `data`, which the ruleset documents as the
# way to supply a class or style file. That removes the fetch entirely.
hermetic_latex.toolchain()
use_repo(hermetic_latex, "hermetic_latex", "hermetic_latex_ghostscript")

register_toolchains("@hermetic_latex//:all")

# Rust, so that claims about what the language can express are compiled
# rather than argued. docs/rust-embedding.md section 8 lists what is being
# checked. The toolchain is fetched by the ruleset, so nothing is installed
# on the machine.
# The constraint values a platform is written in: the CPU Vreteno is,
# and the absence of an operating system.
bazel_dep(name = "platforms", version = "0.0.11")

bazel_dep(name = "rules_rust", version = "0.74.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    # The bare-metal RISC-V target Vreteno is: thirty-two bit, the
    # multiply extension, no compressed instructions, no operating
    # system. Naming it here makes the build fetch that target's
    # standard library by checksum, as it fetches the host's, so
    # nothing has to be installed to compile for the core.
    extra_target_triples = ["riscv32imc-unknown-none-elf"],
    versions = [
        # Stable and nightly both, because the open question is which of
        # the two the numeric library needs.
        "1.90.0",
        "nightly/2026-08-01",
    ],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Prebuilt tools, fetched by checksum for every platform they ship for.
# vcdcvt and sqlite2drawtiming turn a VCD into a signals database and
# the database into drawtiming text; //tools/dt2tikz draws that text.
bazel_dep(name = "rules_multitool", version = "1.11.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

# The one external crate: an FST writer, so a waveform is a compressed
# binary the tools read as they read VCD. Pinned by a lockfile;
# `CARGO_BAZEL_REPIN=1 bazel sync --only=crates` regenerates it.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.spec(
    package = "fst-writer",
    version = "0.3.1",
)
# The reference reader, for checking what the writer wrote.
crate.spec(
    package = "wellen",
    version = "0.25.6",
)
crate.from_specs(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
)
use_repo(crate, "crates")

# VHDL simulation, hermetic (nvc is built from source through the
# registry): the lowered designs are simulated against the traces the Rust
# simulation wrote.
bazel_dep(name = "rules_nvc", version = "4.5.2")

# Verilog simulation, hermetic (Verilator is built from source through the
# registry): the same lowered designs, as Verilog, are simulated against
# the same traces, so both emitters are checked.
bazel_dep(name = "rules_verilator", version = "1.1.2")
bazel_dep(name = "rules_verilog", version = "1.4.3")
bazel_dep(name = "rules_cc", version = "0.2.22")

register_toolchains("@rules_verilator//verilator:verilator_toolchain")

# Synthesis, hermetic: rules_vivado installs Vivado itself, from the AMD
# installer archive named here, into a shared install cache, and every
# workspace on the machine reuses that one installation. AMD's download
# needs a login, so the archive is served from a local path; `.bazelrc`
# selects the mode. A cold install moves the archive three times and
# needs about 300 GB free at its peak, see the ruleset's
# docs/vivado-toolchain.md; a warm cache is found in seconds. The cache
# key is the URL and the selection with no `sha256`, exactly as the
# other workspaces on this machine state them, so that the key matches
# theirs and the installation is shared rather than redone.
bazel_dep(name = "rules_vivado", version = "3.10.2")
# Shell binaries: the remote programmer and the serial watcher.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Go, for the serial watcher that runs on the board's machine: one
# static binary, uploaded, with the standard library alone.
bazel_dep(name = "rules_go", version = "0.61.1")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.25.1")

vivado = use_extension("@rules_vivado//:extensions.bzl", "vivado")
vivado.install(
    install_cache = "/data/cache/vivado-install",
    urls = ["file:///data/tools/archives/FPGAs_AdaptiveSoCs_Unified_SDI_2025.2_1114_2157_1.tar"],
    modules = ["Artix-7"],
)
