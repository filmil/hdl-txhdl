# SPDX-License-Identifier: Apache-2.0
# The kernel for FireSim's Rocket core on the AX7A200B (issue 2015), over
# tinyconfig, as linux/vreteno.config is for Vreteno: only what the
# machine has and what a BusyBox initramfs needs. Every byte is loaded
# over the Ethernet host link, four to a register write, so it stays
# small.
#
# The machine, from the device tree in the boot ROM: one 64-bit hart,
# Sv39, the CLINT and the PLIC, a SiFive serial port, 1 GiB of DRAM at
# 0x80000000, and the kernel in S mode under OpenSBI.
CONFIG_MMU=y
CONFIG_SMP=n
# The core has F and D; the userspace is soft float, so the kernel
# leaves them alone.
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_SVPBMT=n
CONFIG_MODULES=n
CONFIG_DEBUG_INFO_NONE=y
# The timer through SBI, the PLIC's supervisor target, the serial port
# and its console, early too.
CONFIG_RISCV_TIMER=y
CONFIG_SIFIVE_PLIC=y
CONFIG_TTY=y
CONFIG_SERIAL_SIFIVE=y
CONFIG_SERIAL_SIFIVE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
# The boot ROM's device tree has no bootargs, so the kernel brings its
# own. The serial port's speed is the one its divisor resets to, 271 on
# the 1 GHz bus, which FireSim's UART bridge decodes: at Linux's default
# of 115200 the bridge read every byte after the console's handover as
# a NUL.
CONFIG_CMDLINE="earlycon console=ttySIF0,3686400"
# The initramfs, inside the kernel and gzipped: build.sh names the cpio.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
