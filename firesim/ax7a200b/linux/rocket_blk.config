# SPDX-License-Identifier: Apache-2.0
# Over rocket.config, for the root file system on FireSim's block device
# (issue 2020). The device is in the boot ROM's device tree as
# blkdev-controller@10015000, "ucb-bar,blkdev", on the PLIC's interrupt
# 1; build.sh builds FireSim's iceblk.c into drivers/block, which drives
# it as /dev/iceblk. The root is the ext2 image on it, read-only, and
# the kernel takes no initramfs.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_EXT2_FS=y
# No initramfs, so nothing to compress one with.
CONFIG_INITRAMFS_COMPRESSION_GZIP=n
# rocket.config's line, with the root and the program to start on it.
CONFIG_CMDLINE="earlycon console=ttySIF0,3686400 root=/dev/iceblk rootfstype=ext2 ro rootwait init=/init"
