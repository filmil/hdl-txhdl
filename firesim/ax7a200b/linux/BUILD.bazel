# SPDX-License-Identifier: Apache-2.0
# Linux on FireSim's Rocket core over the Ethernet host link (issue
# 2015): the mainline kernel with a BusyBox initramfs inside it, and
# OpenSBI around both, as one ELF the driver loads into the DDR3. Built
# by //linux's scripts with the same hermetic LLVM and sources, for
# RV64. Manual, since a kernel is minutes of work:
#
#   bazel build //firesim/ax7a200b/linux:rocket_linux
load("//linux:defs.bzl", "LINUX_ENV", "LINUX_TOOLS")

package(default_visibility = ["//visibility:public"])

# musl, compiler-rt's builtins and the kernel's headers, for rv64imac
# at the soft-float ABI lp64.
genrule(
    name = "rv64_sysroot",
    srcs = [
        "@compiler_rt//:src",
        "@linux//:src",
        "@musl//:src",
    ],
    outs = ["rv64_sysroot.tar"],
    cmd = LINUX_ENV + " RV_XLEN=64 $(execpath //linux:userspace.sh) sysroot " +
          "$(execpath @compiler_rt//:src) $(execpath @musl//:src) " +
          "$(execpath @linux//:src) $@",
    tags = ["manual"],
    tools = LINUX_TOOLS,
)

# BusyBox, configured as Vreteno's is.
genrule(
    name = "busybox",
    srcs = [
        ":rv64_sysroot",
        "@busybox//:src",
        "//linux:busybox.config",
    ],
    outs = [
        "bin/busybox",
        "busybox.full.config",
    ],
    cmd = LINUX_ENV + " RV_XLEN=64 $(execpath //linux:userspace.sh) busybox " +
          "$(execpath :rv64_sysroot) $(execpath @busybox//:src) " +
          "$(execpath //linux:busybox.config) $(execpath bin/busybox) " +
          "$(execpath busybox.full.config)",
    tags = ["manual"],
    tools = LINUX_TOOLS,
)

# The root file system on FireSim's block device (issue 2020): BusyBox,
# the init that runs from it, a file to read back, and the directories
# the init mounts over, as an ext2 image the driver serves with
# +blkdev0=. genext2fs writes it from a directory, with every owner root
# and every time stamp at the epoch, so the same inputs give the same
# bytes whenever they were written. 4 MiB in 1 KiB blocks; only the blocks the kernel reads cross
# the cable.
genrule(
    name = "blk_root",
    srcs = [
        "bin/busybox",
        "blk_init",
    ],
    outs = ["blk_root.ext2"],
    cmd = "\n".join([
        "set -euo pipefail",
        "r=$(@D)/blk_root.d",
        "rm -rf $$r && mkdir -p $$r/bin $$r/dev $$r/etc $$r/proc $$r/sys",
        "cp $(execpath bin/busybox) $$r/bin/busybox",
        "cp $(execpath blk_init) $$r/init",
        "chmod 0755 $$r/bin/busybox $$r/init",
        "echo 'txhdl: this line was read from the block device' > $$r/etc/txhdl-root",
        # genext2fs takes each file's modification time from the file
        # and only its own from SOURCE_DATE_EPOCH, so the files go to
        # the epoch first.
        "find $$r -exec touch -h -d @0 {} +",
        "SOURCE_DATE_EPOCH=0 $(execpath @genext2fs) -B 1024 -b 4096 -N 64 -q -d $$r $@",
        "rm -rf $$r",
    ]),
    tags = ["manual"],
    tools = ["@genext2fs"],
)

genrule(
    name = "initramfs",
    srcs = [
        "bin/busybox",
        "init",
        "@linux//:src",
    ],
    outs = ["initramfs.cpio"],
    cmd = LINUX_ENV + " $(execpath //linux:userspace.sh) initramfs " +
          "$(execpath bin/busybox) $(execpath init) $(execpath @linux//:src) " +
          "- $@",
    tags = ["manual"],
    tools = LINUX_TOOLS,
)

# The kernel, tinyconfig with rocket.config over it and the initramfs
# inside.
genrule(
    name = "kernel",
    srcs = [
        "@linux//:src",
        "initramfs.cpio",
        "rocket.config",
    ],
    outs = [
        "Image",
        "kernel.config",
        "System.map",
    ],
    cmd = LINUX_ENV + " INITRAMFS=$(execpath initramfs.cpio) " +
          "$(execpath //linux:build.sh) kernel $(execpath @linux//:src) " +
          "$(execpath rocket.config) $(execpath Image) " +
          "$(execpath kernel.config) $(execpath System.map) -",
    tags = ["manual"],
    tools = LINUX_TOOLS,
)

# OpenSBI with the kernel as its payload: what the driver loads.
genrule(
    name = "rocket_linux",
    srcs = [
        "@opensbi//:src",
        "Image",
    ],
    outs = ["rocket_linux.elf"],
    cmd = LINUX_ENV + " $(execpath //linux:build.sh) payload " +
          "$(execpath @opensbi//:src) $(execpath Image) $@",
    tags = ["manual"],
    tools = LINUX_TOOLS,
)

# The kernel whose root is on FireSim's block device (issue 2020):
# rocket.config with rocket_blk.config over it, FireSim's iceblk driver
# built in, and no initramfs, so the driver loads the kernel alone and
# serves blk_root.ext2 with +blkdev0=.
genrule(
    name = "blk_kernel",
    srcs = [
        "@iceblk_driver//:src",
        "@linux//:src",
        "rocket.config",
        "rocket_blk.config",
    ],
    outs = [
        "blk/Image",
        "blk/kernel.config",
        "blk/System.map",
    ],
    cmd = LINUX_ENV + " EXTRA_FRAGMENT=$(execpath rocket_blk.config) " +
          "BUILTIN_DRIVER=$(execpath @iceblk_driver//:src)/iceblk.c " +
          "$(execpath //linux:build.sh) kernel $(execpath @linux//:src) " +
          "$(execpath rocket.config) $(execpath blk/Image) " +
          "$(execpath blk/kernel.config) $(execpath blk/System.map) -",
    tags = ["manual"],
    tools = LINUX_TOOLS,
)

# OpenSBI with that kernel as its payload.
genrule(
    name = "rocket_blk_linux",
    srcs = [
        "@opensbi//:src",
        "blk/Image",
    ],
    outs = ["rocket_blk_linux.elf"],
    cmd = LINUX_ENV + " $(execpath //linux:build.sh) payload " +
          "$(execpath @opensbi//:src) $(execpath blk/Image) $@",
    tags = ["manual"],
    tools = LINUX_TOOLS,
)
