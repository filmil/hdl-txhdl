# SPDX-License-Identifier: Apache-2.0
# FireSim on the AX7A200B with Ethernet as the host link (issue 1931),
# milestone 1: FireSim's GCD example, whose bridges are registers only.
#
# The board: the MAC's two halves and the PHY's RGMII, as //eth's echo
# design has them; HostBridge, HostLink and LiteMaster joined
# (//lib/parts, remote::host), lowered; and Golden Gate's FPGATop for GCD at 50 MHz. The host: FireSim's
# driver for GCD with a platform file that speaks frames instead of PCIe.
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load(
    "@rules_vivado//build/vivado:rules.bzl",
    "vivado_ip",
    "vivado_program_device",
)
load("//tools/vivado:defs.bzl", "vivado_place_and_route2", "vivado_synthesis2")

package(default_visibility = ["//visibility:public"])

# The hand-written top, for //tools/topcheck (issue 508).
exports_files(["firesim_eth_top.v"])

# The Verilog of `host_bridge`, with HostLink and LiteMaster inside.
rust_binary(
    name = "netlist",
    srcs = ["netlist.rs"],
    edition = "2021",
    deps = ["//lib/parts:txhdl_parts"],
)

genrule(
    name = "hostlink_v",
    outs = ["hostlink.v"],
    cmd = "$(location :netlist) > $@",
    tools = [":netlist"],
)

# The Verilog of `rocket_link`: EthShare, HostBridge and StreamBridge
# joined, the Rocket design's host link (issue 1988).
rust_binary(
    name = "rocket_netlist",
    srcs = ["rocket_netlist.rs"],
    edition = "2021",
    proc_macro_deps = ["//lib:txhdl_macros"],
    deps = [
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
)

genrule(
    name = "rocket_link_v",
    outs = ["rocket_link.v"],
    cmd = "$(location :rocket_netlist) > $@",
    tools = [":rocket_netlist"],
)

# The Rocket design's memory (issue 1988). FPGATop's mem_0 port is AXI4
# with 64-bit data, 16-bit IDs and a 30-bit address. The MIG is
# //ddr3's ddr3_mig_axi with its AXI port at those widths (the MIG
# upsizes to its 256-bit native port inside); mig/rocket_mig.prj differs
# from ddr3/mig/ddr3_mig_axi.prj in those two widths and the module name
# alone. Manual, as every Vivado target is.
vivado_ip(
    name = "rocket_mig",
    config = {"XML_INPUT_FILE": "data:rocket_mig.prj"},
    data = ["mig/rocket_mig.prj"],
    part = "xc7a200tfbg484-2",
    tags = ["manual"],
    vlnv = "xilinx.com:ip:mig_7series:4.2",
)

# mem_0 from the simulator's 50 MHz to the MIG's 100 MHz user clock.
vivado_ip(
    name = "rocket_mem_cc",
    config = {
        "PROTOCOL": "AXI4",
        "READ_WRITE_MODE": "READ_WRITE",
        "ADDR_WIDTH": "30",
        "DATA_WIDTH": "64",
        "ID_WIDTH": "16",
        "AWUSER_WIDTH": "0",
        "ARUSER_WIDTH": "0",
        "RUSER_WIDTH": "0",
        "WUSER_WIDTH": "0",
        "BUSER_WIDTH": "0",
        "ACLK_ASYNC": "1",
        "SYNCHRONIZATION_STAGES": "3",
    },
    part = "xc7a200tfbg484-2",
    tags = ["manual"],
    vlnv = "xilinx.com:ip:axi_clock_converter:2.1",
)

# GCD through Golden Gate for the Nitefury II platform config, which this
# board shares for GCD: the control port is the same, and GCD uses none
# of the ports where the two boards differ.
genrule(
    name = "gcd_goldengate",
    srcs = [
        "//firesim:testdata/GCD.fir",
        "//firesim:testdata/GCD.anno.json",
    ],
    outs = [
        "gcd/FireSim-generated.sv",
        "gcd/FireSim-generated.const.h",
    ],
    cmd = "$(location @firesim_goldengate//:goldengate) " +
          "-i $(location //firesim:testdata/GCD.fir) -td $(RULEDIR)/gcd " +
          "-faf $(location //firesim:testdata/GCD.anno.json) " +
          "-ggcp firesim.midasexamples -ggcs DefaultNitefuryConfig " +
          "--output-filename-base FireSim-generated " +
          "--allow-unrecognized-annotations --no-dedup " +
          "> $(RULEDIR)/gcd/goldengate.log 2>&1 " +
          "|| { tail -40 $(RULEDIR)/gcd/goldengate.log >&2; exit 1; }",
    tools = ["@firesim_goldengate//:goldengate"],
)

filegroup(
    name = "xdc",
    srcs = [
        "ax7a200b_firesim.xdc",
        "//eth:echo_xdc",
    ],
)

# The board through Vivado's synthesis, and then place and route to a
# bitstream. Manual, as every Vivado target is:
#
#   bazel build //firesim/ax7a200b:gcd_eth_pnr
vivado_synthesis2(
    name = "gcd_eth_synth",
    srcs = [
        ":hostlink_v",
        ":gcd/FireSim-generated.sv",
        "//eth:mac_v",
        "//eth:eth_rgmii",
        "//lib/board:chan_cdc",
        "firesim_eth_top.v",
    ],
    part = "xc7a200tfbg484-2",
    top = "firesim_eth_top",
    xdcs = [":xdc"],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "gcd_eth_pnr",
    synthesis = ":gcd_eth_synth",
    xdcs = [":xdc"],
    tags = ["manual"],
)

# FireSim's Rocket design on the board (issue 1988): the prebuilt
# design from bazel_rules_firesim, the host link with the stream port,
# and the target's DRAM on the MIG. Manual:
#
#   bazel build //firesim/ax7a200b:rocket_eth_pnr
filegroup(
    name = "rocket_xdc",
    srcs = [
        "ax7a200b_rocket.xdc",
        "//cpu/vreteno:board/ax7a200_ddr3.xdc",
        "//eth:echo_xdc",
    ],
)

vivado_synthesis2(
    name = "rocket_eth_synth",
    srcs = [
        ":rocket_link_v",
        "@firesim_rocket_nitefury//:sv",
        "//eth:mac_v",
        "//eth:eth_rgmii",
        "//lib/board:chan_cdc",
        "rocket_eth_top.v",
    ],
    part = "xc7a200tfbg484-2",
    top = "rocket_eth_top",
    xdcs = [":rocket_xdc"],
    deps = [
        ":rocket_mem_cc",
        ":rocket_mig",
    ],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "rocket_eth_pnr",
    synthesis = ":rocket_eth_synth",
    xdcs = [":rocket_xdc"],
    tags = ["manual"],
)

# Write it into the board where it is, as //eth:echo_prog does, over the
# tunnel the Vreteno board's daemon opens. Needs the BOARD TOKEN. Bring
# the tunnel up first:
#
#   bazel run //cpu/vreteno/board/remote:hw_server
#   bazel run //firesim/ax7a200b:gcd_eth_prog -- \
#       --hostport localhost:3122 --device '*/xilinx_tcf/Digilent/*'
#
# This writes the FPGA itself, which the next power cycle forgets.
vivado_program_device(
    name = "gcd_eth_prog",
    prog_daemon = "//cpu/vreteno/board/remote:hw_server",
    deps = [":gcd_eth_pnr"],
    tags = ["manual"],
)

# The host: FireSim's driver for GCD (main, entry, the example's test and
# harness), with this platform file in place of FireSim's PCIe ones.
cc_library(
    name = "gcd_const",
    hdrs = ["gcd/FireSim-generated.const.h"],
    includes = ["gcd"],
)

# The frame the host speaks, laid out as HostBridge reads it, and its
# test, byte for byte.
cc_library(
    name = "eth_frame",
    hdrs = ["eth_frame.h"],
)

cc_test(
    name = "eth_frame_test",
    size = "small",
    srcs = ["eth_frame_test.cc"],
    deps = [":eth_frame"],
)

# Run it on the machine cabled to the board, as one with cap_net_raw:
#
#   gcd_eth_driver +iface=<interface>
cc_binary(
    name = "gcd_eth_driver",
    srcs = [
        "simif_ax7a200b_eth.cc",
        "@firesim_target//:sim/midas/src/main/cc/entry.cc",
        "@firesim_target//:sim/midas/src/main/cc/main.cc",
        "@firesim_target//:sim/src/main/cc/midasexamples/TestGCD.cc",
        "@firesim_target//:sim/src/main/cc/midasexamples/TestHarness.cc",
    ],
    copts = [
        "-std=c++20",
        "-DFIRESIM",
        "-Wno-unused-variable",
    ],
    deps = [
        ":eth_frame",
        ":gcd_const",
        "@firesim_target//:examples_driver_hdrs",
        "@firesim_target//:midas_bridges",
    ],
)

# The sources by name, for the documents' listings.
filegroup(
    name = "sources",
    srcs = glob(["*.v", "*.xdc", "*.rs", "*.cc", "*.h"]),
)

# The host for the Rocket design (issue 1988): FireSim's main and entry,
# FireChip's bridge drivers, the design's header from the prebuilt
# design, and the platform file that speaks frames.
cc_binary(
    name = "rocket_eth_driver",
    srcs = [
        "simif_ax7a200b_eth.cc",
        "@firesim_target//:sim/midas/src/main/cc/entry.cc",
        "@firesim_target//:sim/midas/src/main/cc/main.cc",
    ],
    copts = [
        "-std=c++20",
        "-DFIRESIM",
        "-Wno-inconsistent-missing-override",
    ],
    deps = [
        ":eth_frame",
        "@chipyard_firechip//:firechip_driver_lib",
        "@firesim_rocket_nitefury//:const_h",
    ],
)

# The program the Rocket design runs first: a line on the UART, then exit
# through tohost. Assembled and linked by the LLVM toolchain's clang and
# ld.lld for RV64.
genrule(
    name = "hello_riscv",
    srcs = [
        "hello/hello.S",
        "hello/hello.ld",
    ],
    outs = ["hello.riscv"],
    cmd = "for f in $(execpaths @llvm_toolchain_llvm//:bin); do " +
          "case $$f in */bin/clang) CC=$$f;; */bin/ld.lld) LD=$$f;; esac; done; " +
          "$$CC --target=riscv64-unknown-elf -march=rv64imac -mabi=lp64 " +
          "-mcmodel=medany -c $(location hello/hello.S) -o $(@D)/hello.o && " +
          "$$LD -T $(location hello/hello.ld) $(@D)/hello.o -o $@",
    tools = ["@llvm_toolchain_llvm//:bin"],
)
