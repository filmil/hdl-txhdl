# SPDX-License-Identifier: Apache-2.0
common --registry=https://raw.githubusercontent.com/filmil/bazel-registry/main
common --registry=https://bcr.bazel.build

# Every document is stamped with the commit it was built from.
build --workspace_status_command=tools/workspace_status.sh

# The formatter's own settings, `max_width = 80`, wherever it runs:
# the prescribed run of `@rules_rust//:rustfmt`, and the `rustfmt_test`
# targets that keep the tree that way. Without this, both use the
# default of 100 columns, and the documents set source at 80 (issue
# 165).
common --@rules_rust//:rustfmt.toml=//:rustfmt.toml

# Clippy on every build, its warnings errors, so a lint is dealt with
# where it is written rather than found later in a sweep (issue 228).
# A lint the lowering forces is allowed at the item it fires on, with
# the reason beside it: the lowering reads `name: value` and not a
# field shorthand, `&` and not a range, and an arm's alternatives one
# by one and not as a range.
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks
# The one lint allowed everywhere: a unit's ports are tuples of channel
# types, and a join's are tuples of those, so the types the library
# writes are as complex as the hardware they stand for.
build --@rules_rust//:clippy_flags=-Dwarnings,-Aclippy::type_complexity

# Vivado from the Bazel-installed toolchain, not Docker or the host.
build --@rules_vivado//:vivado_mode=hermetic

# Shared caches on the hdlfactory hosts, where the file exists; a no-op
# elsewhere. The repository cache there already holds the installer.
try-import /data/cache/ci.bazelrc

# The machine the board is attached to, with its programming cable and
# its serial bridge: the one place that names it. The remote programmer
# and the serial watcher read it, and `--server=HOST` on their command
# line overrides it.
run --run_env=TXHDL_BOARD_SERVER=srv.filmar.us
