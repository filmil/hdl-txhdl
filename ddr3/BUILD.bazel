# The board's DDR3 memory as an AXI peripheral: AMD's MIG controller,
# generated by the build, as a foreign module behind a Wishbone of
# words, and the bridge from the link to it.
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ddr3",
    srcs = ["src/lib.rs"],
    crate_name = "ddr3",
    edition = "2021",
    proc_macro_deps = ["//lib:txhdl_macros"],
    deps = [
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
)

rust_test(
    name = "ddr3_test",
    crate = ":ddr3",
    edition = "2021",
)

# The controller as its netlist names it: the wrapper, for a simulation
# or a synthesis to read beside the lowering; the controller itself is
# `:ddr3_mig`, a library those depend on.
filegroup(
    name = "hdl",
    srcs = ["hdl/ddr3_wb32.v"],
)

# The sources by name, for the documents' listings.
filegroup(
    name = "sources",
    srcs = glob(["src/*.rs"]) + ["hdl/ddr3_wb32.v"],
)

# The controller: AMD's MIG 7 Series, generated by the build from the
# project file in `mig/`, which names the board's two x16 chips, the
# 400 MHz memory clock at a 4:1 ratio to the 100 MHz user clock, the
# 200 MHz input that is also the delay reference, and every pin from
# `//cpu/vreteno/board:ax7a200_ddr3.xdc`. The example design comes
# with it, for its traffic generator and the Micron model. Manual, as
# every Vivado target is:
#
#   bazel build //ddr3:ddr3_mig
load("@rules_vivado//build/vivado:rules.bzl", "vivado_ip")

vivado_ip(
    name = "ddr3_mig",
    config = {"XML_INPUT_FILE": "data:ddr3_mig.prj"},
    data = ["mig/ddr3_mig.prj"],
    example_design = True,
    part = "xc7a200tfbg484-2",
    tags = ["manual"],
    vlnv = "xilinx.com:ip:mig_7series:4.2",
)
