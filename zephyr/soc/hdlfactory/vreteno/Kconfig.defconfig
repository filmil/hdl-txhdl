# SPDX-License-Identifier: Apache-2.0

if SOC_VRETENO

config NUM_IRQS
	# The platform controller carries two sources, the serial port's
	# receive line and the board's own input, above the local ones.
	default 12

config SYS_CLOCK_HW_CYCLES_PER_SEC
	# The design clock on the board, which is also the device tree's
	# timebase-frequency. Both come from the same 100 MHz.
	default 100000000

# `RISCV_SOC_INTERRUPT_INIT` is deliberately not set here. It makes
# `z_prep_c` call `soc_interrupt_init()`, and this SoC has no such
# function to call, so the image does not link. This machine's
# controller is initialised by its own driver like any other.

endif # SOC_VRETENO
