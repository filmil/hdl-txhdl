# SPDX-License-Identifier: Apache-2.0
#
# The Zephyr port of this machine: a SoC, a board, a device tree and a
# console driver, arranged as a Zephyr module so that a Zephyr of the
# reader's choosing builds against it.
#
#   west build -b ax7a200b samples/hello_world \
#     -- -DZEPHYR_EXTRA_MODULES=$(pwd)/zephyr
#
# Nothing here is built by Bazel. Zephyr's build is CMake and Kconfig
# and its own Python, and vendoring that hermetically is a piece of
# work in its own right rather than a detail of this port; see the
# issue named in `zephyr/README.md`. What Bazel does own is the check
# that the port still describes the hardware, which is
# `//cpu/vreteno:zephyr_port_test`: it reads the files below at
# compile time and holds their addresses to the design's own
# constants.

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":defs.bzl", "zephyr_image")

package(default_visibility = ["//visibility:public"])

# Every file of the port, as the module CMake is pointed at.
filegroup(
    name = "module",
    srcs = glob(["**"]),
)

# `hello_world` for this board, built by this repository's own
# toolchain rather than by a reader following the README above.
zephyr_image(
    name = "hello_world",
    board = "ax7a200b",
    module = ":module",
    sample = "samples/hello_world",
)

# What the image proves. Not that it exists, which this port showed to
# be worth almost nothing, but that the configuration the build
# generated is this machine's.
# The same sample with a network stack, which is what compiles the
# Ethernet driver. Without it `ETH_VRETENO` is off, nothing hands
# `eth_vreteno.c` to a compiler, and the driver is checked only as
# text: the state `uart_vreteno.c` was in when it kept an implicit
# declaration of `sys_read32`.
zephyr_image(
    name = "hello_world_net",
    board = "ax7a200b",
    conf = "net.conf",
    module = ":module",
    sample = "samples/hello_world",
)

filegroup(
    name = "hello_world_net_config",
    srcs = [":hello_world_net"],
    output_group = "config",
)

sh_test(
    name = "eth_config_test",
    srcs = ["eth_config_test.sh"],
    args = ["$(location :hello_world_net_config)"],
    data = [":hello_world_net_config"],
)

filegroup(
    name = "hello_world_config",
    srcs = [":hello_world"],
    output_group = "config",
)

sh_test(
    name = "config_test",
    srcs = ["config_test.sh"],
    args = ["$(location :hello_world_config)"],
    data = [":hello_world_config"],
)

# The files the port test reads, so that editing any of them reruns
# the check rather than leaving it stale.
filegroup(
    name = "port_sources",
    srcs = [
        "dts/riscv/hdlfactory/vreteno.dtsi",
        "drivers/serial/uart_vreteno.c",
        "soc/hdlfactory/vreteno/Kconfig",
        "drivers/serial/Kconfig.vreteno",
        "boards/hdlfactory/ax7a200b/ax7a200b_defconfig",
    ],
)

# Every file of the port, for a document to list or an archive to
# take.
filegroup(
    name = "sources",
    srcs = glob([
        "**/*.c",
        "**/*.dts",
        "**/*.dtsi",
        "**/*.yaml",
        "**/*.yml",
        "**/*.txt",
        "**/Kconfig*",
        "**/*_defconfig",
    ]),
)
