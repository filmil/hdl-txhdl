/* SPDX-License-Identifier: Apache-2.0 */
/*
 * Where a download is staged: 256 MiB of DDR3 at 0x4800_0000, up to
 * 0x5800_0000, above this image and out of the allocator's hands,
 * since `boot` copies from here over the image that is running (issue
 * 143). Beside the Ethernet buffers, in the port's own
 * `reserved-memory` under `soc`. It was 16 MiB, then 48 MiB for Doom's
 * game data, which `boot` brings as the boot image's ramdisk and which
 * is 28.8 MiB (issue 1177); it is 256 MiB for programs whose ramdisk
 * is a data set of 56 MB and more (issue 1731). Nothing else the board
 * uses is above 0x4800_0000: the framebuffers, Razboj's list and its
 * tiles, the Ethernet buffers, the probes' buffers and Linux's initrd
 * are all below it, and the DDR3 is a gigabyte.
 */
/ {
	/*
	 * The server's RAM, its network buffers, stacks and heap among it,
	 * is the core's own data memory (issue 1230): the 64 KiB at
	 * 0x1_0000 on the core's port (#1275), which a load reaches in a
	 * cycle or two where the DDR3 takes tens. Code stays in the DDR3,
	 * since a fetch from the core's memory faults, and the DMA slots
	 * and the staging area stay there too, since the engines cannot
	 * reach the core's memory. Linked as execute-in-place: the image
	 * is code in the DDR3, and its data is copied to the core's memory
	 * as it starts.
	 */
	chosen {
		zephyr,sram = &lram;
		zephyr,flash = &ddr;
	};

	soc {
		lram: memory@10000 {
			compatible = "mmio-sram";
			reg = <0x00010000 DT_SIZE_K(64)>;
		};

		reserved-memory {
			fastboot_stage: memory@48000000 {
				reg = <0x48000000 0x10000000>;
			};
		};
	};
};
