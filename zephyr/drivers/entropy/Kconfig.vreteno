# SPDX-License-Identifier: Apache-2.0

config ENTROPY_VRETENO
	bool "Vreteno entropy source"
	default y
	depends on DT_HAS_HDLFACTORY_VRETENO_TRNG_ENABLED
	depends on ENTROPY_GENERATOR
	select ENTROPY_HAS_DRIVER
	help
	  The entropy source of the Vreteno machine: ring oscillators
	  sampled, folded, debiased and buffered by the hardware, read a
	  word at a time, and conditioned here with SHA-256, 32 words to
	  each 32 bytes (issue 780). `ENTROPY_HAS_DRIVER` is what makes the
	  random subsystem take its numbers from a device rather than from
	  the test generator, which is a counter.

	  The SHA-256 is Mbed TLS's, which the SoC turns on by default
	  with this driver. It is not selected here, since Mbed TLS can
	  select ENTROPY_GENERATOR, which this depends on, and Kconfig
	  calls that a loop. The driver does not compile without it.
