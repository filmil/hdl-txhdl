# Rust compiled for Vreteno itself: a program that runs on the core
# rather than on the machine the simulation runs on.
#
# The toolchain is hermetic. `MODULE.bazel` names the bare-metal
# RISC-V target beside the host's, so the build fetches that target's
# standard library by checksum as it fetches everything else, and
# nothing is installed on the machine. The linker is `rust-lld`, which
# comes with the toolchain, so there is no cross binutils either.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load(":defs.bzl", "vreteno_elf", "vreteno_fastboot", "vreteno_flat", "vreteno_image")

package(default_visibility = ["//visibility:public"])

# The machine Vreteno is, for Bazel's toolchain resolution.
platform(
    name = "vreteno",
    constraint_values = [
        "@platforms//cpu:riscv32",
        "@platforms//os:none",
    ],
)

# The flags every program for this core is built with. The core is
# RV32IMC, which is the target the ruleset maps, so the target's own
# instruction set is used as it is. Optimising for size is not a
# preference: the instruction memory is 4 KiB, and a debug assertion
# pulls in `core`'s panic formatting, which does not fit.
VRETENO_FLAGS = [
    "-Copt-level=z",
    "-Cdebug-assertions=no",
    "-Coverflow-checks=no",
    "-Cpanic=abort",
    "-Clinker=rust-lld",
    "-Clink-arg=-Tcpu/vreteno/rust/vreteno.ld",
]

# The same, for a program that is loaded into the board's memory and
# runs there rather than living in the netlist.
VRETENO_RAM_FLAGS = [
    "-Copt-level=z",
    "-Cdebug-assertions=no",
    "-Coverflow-checks=no",
    "-Cpanic=abort",
    "-Clinker=rust-lld",
    "-Clink-arg=-Tcpu/vreteno/rust/vreteno_ram.ld",
]

rust_binary(
    name = "hello",
    srcs = ["hello.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS,
    # Built through the transition below, not for this machine.
    tags = ["manual"],
    deps = ["//cpu/vreteno/rust/hal:vreteno_hal"],
)

# The image of that program, as Rust source: the instruction words and
# the bytes the data memory starts with.
vreteno_image(
    name = "hello_image",
    platform = ":vreteno",
    program = ":hello",
)

rust_library(
    name = "hello_program",
    srcs = [":hello_image"],
    crate_name = "hello_program",
    edition = "2021",
)

