# Rust compiled for Vreteno itself: a program that runs on the core
# rather than on the machine the simulation runs on.
#
# The toolchain is hermetic. `MODULE.bazel` names the bare-metal
# RISC-V target beside the host's, so the build fetches that target's
# standard library by checksum as it fetches everything else, and
# nothing is installed on the machine. The linker is `rust-lld`, which
# comes with the toolchain, so there is no cross binutils either.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load(":defs.bzl", "vreteno_flat", "vreteno_image")

package(default_visibility = ["//visibility:public"])

# The machine Vreteno is, for Bazel's toolchain resolution.
platform(
    name = "vreteno",
    constraint_values = [
        "@platforms//cpu:riscv32",
        "@platforms//os:none",
    ],
)

# The flags every program for this core is built with. The core is
# RV32IMC, which is the target the ruleset maps, so the target's own
# instruction set is used as it is. Optimising for size is not a
# preference: the instruction memory is 4 KiB, and a debug assertion
# pulls in `core`'s panic formatting, which does not fit.
VRETENO_FLAGS = [
    "-Copt-level=z",
    "-Cdebug-assertions=no",
    "-Coverflow-checks=no",
    "-Cpanic=abort",
    "-Clinker=rust-lld",
    "-Clink-arg=-Tcpu/vreteno/rust/vreteno.ld",
]

# The same, for a program that is loaded into the board's memory and
# runs there rather than living in the netlist.
VRETENO_RAM_FLAGS = [
    "-Copt-level=z",
    "-Cdebug-assertions=no",
    "-Coverflow-checks=no",
    "-Cpanic=abort",
    "-Clinker=rust-lld",
    "-Clink-arg=-Tcpu/vreteno/rust/vreteno_ram.ld",
]

rust_binary(
    name = "hello",
    srcs = ["hello.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS,
    # Built through the transition below, not for this machine.
    tags = ["manual"],
    deps = ["//cpu/vreteno/rust/hal:vreteno_hal"],
)

# The image of that program, as Rust source: the instruction words and
# the bytes the data memory starts with.
vreteno_image(
    name = "hello_image",
    platform = ":vreteno",
    program = ":hello",
)

rust_library(
    name = "hello_program",
    srcs = [":hello_image"],
    crate_name = "hello_program",
    edition = "2021",
)

# An icosahedron, worked out on the core and written into memory as a
# display list for Razboj to fill. Built exactly as the greeting is.
rust_binary(
    name = "ico",
    srcs = ["ico.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS,
    tags = ["manual"],
)

vreteno_image(
    name = "ico_image",
    platform = ":vreteno",
    program = ":ico",
)

rust_library(
    name = "ico_program",
    srcs = [":ico_image"],
    crate_name = "ico_program",
    edition = "2021",
)

# A test of the board's DDR3 memory, run by the core: words written
# across the memory's region, read back, and the verdict on the serial
# port. Built exactly as the greeting is.
rust_binary(
    name = "ddr3",
    srcs = ["ddr3.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS,
    tags = ["manual"],
)

vreteno_image(
    name = "ddr3_image",
    platform = ":vreteno",
    program = ":ddr3",
)

rust_library(
    name = "ddr3_program",
    srcs = [":ddr3_image"],
    crate_name = "ddr3_program",
    edition = "2021",
)

# The same test, built for the board: `--cfg=board_run` adds the header
# line and a dot every ten seconds around the test, which a simulation
# would pay for in simulated time and which the tests that read the
# whole of a run's output would have to state.
rust_binary(
    name = "ddr3_board",
    srcs = ["ddr3.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS + ["--cfg=board_run"],
    tags = ["manual"],
)

vreteno_image(
    name = "ddr3_board_image",
    platform = ":vreteno",
    program = ":ddr3_board",
)

rust_library(
    name = "ddr3_board_program",
    srcs = [":ddr3_board_image"],
    crate_name = "ddr3_board_program",
    edition = "2021",
)

# A program that breathes an LED with the pulse width modulator, for
# the board. Built for the board only: there is nothing for a
# simulation to see in a light that fades over two seconds.
rust_binary(
    name = "fade",
    srcs = ["fade.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS,
    tags = ["manual"],
)

vreteno_image(
    name = "fade_image",
    platform = ":vreteno",
    program = ":fade",
)

rust_library(
    name = "fade_program",
    srcs = [":fade_image"],
    crate_name = "fade_program",
    edition = "2021",
)

# The greeting again, linked for the memory the loader puts a program
# into, and flattened into the image the sender streams. This is what
# the loop looks like once nothing has to be resynthesised: build this,
# send it, watch it run.
rust_binary(
    name = "hello_ram",
    srcs = ["hello.rs"],
    compile_data = ["vreteno_ram.ld"],
    edition = "2021",
    rustc_flags = VRETENO_RAM_FLAGS,
    tags = ["manual"],
    deps = ["//cpu/vreteno/rust/hal:vreteno_hal"],
)

vreteno_flat(
    name = "hello_ram_bin",
    platform = ":vreteno",
    program = ":hello_ram",
)

# A turning icosahedron on the board's HDMI output, drawn by the core
# into the video peripheral's framebuffer with the logo in a corner.
# Linked for the memory rather than the boot memory, and flattened, so
# the loader sends it down the wire: the picture changes in a second
# and the bitstream underneath it does not move.
rust_binary(
    name = "ico_hdmi",
    srcs = ["ico_hdmi.rs"],
    compile_data = ["vreteno_ram.ld"],
    edition = "2021",
    rustc_flags = VRETENO_RAM_FLAGS,
    tags = ["manual"],
    deps = ["//lib/logo:txhdl_logo"],
)

vreteno_flat(
    name = "ico_hdmi_bin",
    platform = ":vreteno",
    program = ":ico_hdmi",
)

# A word to the remote peripheral and back: the last hop of #335 seen
# from the core, with a program on another machine answering the
# frames. Sent down the wire like the icosahedron.
rust_binary(
    name = "remote_ram",
    srcs = ["remote.rs"],
    compile_data = ["vreteno_ram.ld"],
    edition = "2021",
    rustc_flags = VRETENO_RAM_FLAGS,
    tags = ["manual"],
    deps = ["//cpu/vreteno/rust/hal:vreteno_hal"],
)

vreteno_flat(
    name = "remote_ram_bin",
    platform = ":vreteno",
    program = ":remote_ram",
)

# The loader that lives in the boot memory and takes a program off the
# serial port. Built for the board and for the runs that check it.
rust_binary(
    name = "boot",
    srcs = ["boot.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS,
    tags = ["manual"],
)

vreteno_image(
    name = "boot_image",
    platform = ":vreteno",
    program = ":boot",
)

rust_library(
    name = "boot_program",
    srcs = [":boot_image"],
    crate_name = "boot_program",
    edition = "2021",
)

# Input by interrupt: the serial port's receive interrupt through the
# interrupt controller, one interrupt per byte, run on the board's
# design. Built exactly as the greeting is.
rust_binary(
    name = "irq",
    srcs = ["irq.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS,
    tags = ["manual"],
    deps = ["//cpu/vreteno/rust/hal:vreteno_hal"],
)

vreteno_image(
    name = "irq_image",
    platform = ":vreteno",
    program = ":irq",
)

rust_library(
    name = "irq_program",
    srcs = [":irq_image"],
    crate_name = "irq_program",
    edition = "2021",
)

# The trap dispatcher at work: an environment call handled and resumed
# past, and a timer interrupt taken, through the crate rather than a
# vector written by hand. Built exactly as the greeting is.
rust_binary(
    name = "traps",
    srcs = ["traps.rs"],
    compile_data = ["vreteno.ld"],
    edition = "2021",
    rustc_flags = VRETENO_FLAGS,
    tags = ["manual"],
    deps = ["//cpu/vreteno/rust/hal:vreteno_hal"],
)

vreteno_image(
    name = "traps_image",
    platform = ":vreteno",
    program = ":traps",
)

rust_library(
    name = "traps_program",
    srcs = [":traps_image"],
    crate_name = "traps_program",
    edition = "2021",
)

# What the document lists: the program as written, and the script
# that says where each of its sections may go.
filegroup(
    name = "sources",
    srcs = [
        "ico.rs",
        "ico_hdmi.rs",
        "remote.rs",
        "hello.rs",
        "irq.rs",
        "traps.rs",
        "vreteno.ld",
        "vreteno_ram.ld",
    ],
)
