# SPDX-License-Identifier: Apache-2.0
# What every program for the core would otherwise write again: the
# address map in one place, the peripherals as types, the control and
# status registers, a trap entry that saves a frame and dispatches, and
# the reset path. See issue #142.
#
# Built only for the core, through the transition a program's image
# applies: the crate is inline RISC-V assembly from end to end, so it
# is manual, and a program names it in `deps`.
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//cpu/vreteno/rust:defs.bzl", "vreteno_checked")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "vreteno_hal",
    srcs = [
        "lib.rs",
        "trap.rs",
    ],
    crate_name = "vreteno_hal",
    edition = "2021",
    deps = ["//cpu/vreteno/rust/regs:vreteno_regs"],
    # Optimised for size with no debug assertions and no overflow
    # checks, as everything the transition builds is (issue 1248).
    rustc_flags = ["-Cpanic=abort"],
    tags = ["manual"],
)

# The sources by name, for the documents' listings.
filegroup(
    name = "sources",
    srcs = [
        "lib.rs",
        "trap.rs",
    ],
)

# The HAL's source as text, for `//cpu/vreteno:board_programs_test`,
# which holds the bases its `map` types by hand to the board's router
# (issue 709).
exports_files(["lib.rs"])

# Clippy and rustfmt on the HAL as the core's programs link it: the
# checks on a program do not reach the libraries it links, and the HAL
# is built for nothing else (issue 1629).
vreteno_checked(
    name = "hal_checked",
    platform = "//cpu/vreteno/rust:vreteno",
    targets = [":vreteno_hal"],
)
