# SPDX-License-Identifier: Apache-2.0
# Vreteno: an RV32I core in TxHDL. The library holds the core, the
# ISA, the reference model and the programs; the binary runs the
# demonstration and writes its waveform; the test runs the core
# against the model in lockstep.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "vreteno32",
    srcs = [
        "src/core.rs",
        "src/isa.rs",
        "src/lib.rs",
        "src/model.rs",
        "src/program.rs",
    ],
    crate_name = "vreteno32",
    edition = "2021",
    deps = ["//lib:txhdl"],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

# The encoders against the decoder.
rust_test(
    name = "isa_test",
    crate = ":vreteno32",
    edition = "2021",
)

# Run the demonstration:  bazel run //cpu/vreteno
rust_binary(
    name = "vreteno",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//lib:txhdl",
    ],
)

# The core against the model, every cycle.
rust_test(
    name = "lockstep",
    srcs = ["tests/lockstep.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//lib:txhdl",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["src/*.rs", "tests/*.rs"]),
)

# Synthesis of the core's Verilog, as the document build wrote it, on an
# Artix-7 part, with the hermetic Vivado. Manual: a cold run installs
# Vivado first, about 300 GB of transient disk and an hour or two.
#
#   bazel build //cpu/vreteno:vreteno_synth
load("@rules_vivado//build/vivado:rules.bzl", "vivado_project", "vivado_synthesis")

vivado_project(
    name = "vreteno_project",
    srcs = ["//docs:vreteno.v"],
    part = "xc7a200tfbg484-2",
    top_level = "vreteno",
    xdcs = ["vreteno.xdc"],
    tags = ["manual"],
)

vivado_synthesis(
    name = "vreteno_synth",
    project = ":vreteno_project",
    tags = ["manual"],
)
