# Write the fading demonstration into the board.
vivado_program_device(
    name = "vreteno_board_fade_prog",
    prog_daemon = "//cpu/vreteno/board/remote:hw_server",
    deps = [":vreteno_board_fade_pnr"],
    tags = ["manual"],
