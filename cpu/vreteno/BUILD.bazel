    name = "vreteno_board_boot_prog",
    prog_daemon = "//cpu/vreteno/board/remote:hw_server",
    deps = [":vreteno_board_boot_pnr"],
    tags = ["manual"],
)

# Program the board where it is, on the machine .bazelrc names in
# TXHDL_BOARD_SERVER: the daemon brings hw_server up there and a tunnel
# here, //cpu/vreteno/board/remote says how; then Vivado connects to
# the tunnel. The run starts the daemon itself and waits up to two
# minutes for the server to answer (issue 392), so bringing the tunnel
# up first is optional:
#
#   bazel run //cpu/vreteno/board/remote:hw_server
#   bazel run //cpu/vreteno:vreteno_board_prog -- \
#       --hostport localhost:3122 --device '*/xilinx_tcf/Digilent/*'
#
# This writes the FPGA itself, which the next power cycle forgets.
vivado_program_device(
    name = "vreteno_board_prog",
    prog_daemon = "//cpu/vreteno/board/remote:hw_server",
    deps = [":vreteno_board_pnr"],
    tags = ["manual"],
)

# Write the bitstream into the board's QSPI flash, a Micron MT25QL128
# over a 4-bit bus; the same tunnel:
#
#   bazel run //cpu/vreteno:vreteno_board_flash -- \
#       --hostport localhost:3122 --device '*/xilinx_tcf/Digilent/*'
#
# The part is the one this board answers with, read off the chip over
# JTAG: `Mfg ID : 20  Memory Type : ba  Memory Capacity : 18`, which is
# 128 Mbit, 16 MiB. The a200t examples name an MT25QL256, and a target
# that names it is refused by Vivado with `Part identified : mt25ql128
# Part selected : mt25ql256`. Board revisions differ here, so read the
# chip rather than a manual. See issue #210.
vivado_program_flash(
    name = "vreteno_board_flash",
    size = 16,
    flash_part = "mt25ql128-spi-x1_x2_x4",
    interface = "SPIx4",
    deps = [":vreteno_board_pnr"],
    tags = ["manual"],
)

# The bitstream leaves the flash's program area alone: its configuration
# data ends before 0x00A0_0000, where programs begin (issue 312; the
# layout is in docs/flagship.tex). Manual, since the bitstream needs
# Vivado; `vivado_program_flash` writes only the bitstream today, so
# this is the check that a program placed there would survive.
sh_test(
    name = "vreteno_board_fits_test",
    srcs = ["//tools/bitfit:fits_test.sh"],
    args = [
        "$(rootpath //tools/bitfit)",
        "0xa00000",
        "$(rootpaths :vreteno_board_pnr)",
    ],
    data = [
        ":vreteno_board_pnr",
        "//tools/bitfit",
    ],
    tags = ["manual"],
)

# The board with a logic analyser in it (issue 239): the same design
# under a top that adds Vivado's integrated logic analyser on the
# nets a reader of the board asks about first, listed at the head of
# `board/vreteno_board_ila.v` with the reason for each. The analyser
# is generated as an IP core with those probe widths, the bitstream
# is built beside the shipping one and is not it, and a capture is
# read back over the JTAG cable. Manual, as every Vivado target is.
#
#   bazel build //cpu/vreteno:vreteno_board_ila_pnr
#   bazel run //cpu/vreteno/board/remote:hw_server
#   bazel run //cpu/vreteno:vreteno_board_ila_prog -- \
#       --hostport localhost:3122 --device '*/xilinx_tcf/Digilent/*'
#   bazel run //cpu/vreteno:vreteno_board_ila_read
vivado_ila(
    name = "board_ila",
    data_depth = 4096,
    part = "xc7a200tfbg484-2",
    # rst, halt, calib, uart_tx, rx, brk, pwm_pins, vaw, var, vw,
    # net_tx, said, ui_rst: each channel is its valid and its data.
    probe_widths = [1, 1, 1, 1, 1, 1, 4, 36, 36, 37, 10, 1, 1],
    tags = ["manual"],
)

vivado_synthesis2(
    name = "vreteno_board_ila_synth",
    srcs = [
        ":board_v",
        "board/vreteno_board_ila.v",
        "//lib/board:bscan_user4",
        "//ddr3:hdl",
        "//lib/parts:hdl",
    ],
    part = "xc7a200tfbg484-2",
    top = "vreteno_board_ila",
    xdcs = [":ax7a200_xdc"],
    deps = [
        ":board_ila",
        "//ddr3:ddr3_mig_axi",
    ],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "vreteno_board_ila_pnr",
    synthesis = ":vreteno_board_ila_synth",
    xdcs = [":ax7a200_xdc"],
    tags = ["manual"],
)

vivado_program_device(
    name = "vreteno_board_ila_prog",
    prog_daemon = "//cpu/vreteno/board/remote:hw_server",
    deps = [":vreteno_board_ila_pnr"],
    tags = ["manual"],
)

vivado_read_ila(
    name = "vreteno_board_ila_read",
    deps = [":vreteno_board_ila_pnr"],
    tags = ["manual"],
)

# Vivado's JTAG-to-AXI master (issue 241): a host on the board's bus
# reached over the JTAG cable, so that memory and every peripheral can
# be read and written from the hardware manager whatever the core is
# doing. Generated as an IP core; no bursts, since every peripheral on
# this bus serves one beat at a time.
vivado_ip(
    name = "jtag_axi",
    config = {
        "PROTOCOL": "0",
        "M_AXI_ADDR_WIDTH": "32",
        "M_AXI_DATA_WIDTH": "32",
        "M_HAS_BURST": "0",
    },
    part = "xc7a200tfbg484-2",
    tags = ["manual"],
    vlnv = "xilinx.com:ip:jtag_axi:1.2",
)

# The board with a JTAG master on its bus (issue 241): the same design
# under a top that puts Vivado's JTAG-to-AXI master on the lowered
# board's second host port, so that the hardware manager reads and
# writes every address the map names, whatever the core is doing.
# Manual, as every Vivado target is.
#
#   bazel build //cpu/vreteno:vreteno_board_jtag_pnr
#   bazel run //cpu/vreteno:vreteno_board_jtag_prog -- \
#       --hostport localhost:3122 --device '*/xilinx_tcf/Digilent/*'
vivado_synthesis2(
    name = "vreteno_board_jtag_synth",
    srcs = [
        ":board_v",
        "board/vreteno_board_jtag.v",
        "//lib/board:bscan_user4",
        "//ddr3:hdl",
        "//lib/parts:hdl",
    ],
    part = "xc7a200tfbg484-2",
    top = "vreteno_board_jtag",
    xdcs = [":ax7a200_xdc"],
    deps = [
        ":jtag_axi",
        "//ddr3:ddr3_mig_axi",
    ],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "vreteno_board_jtag_pnr",
    synthesis = ":vreteno_board_jtag_synth",
    xdcs = [":ax7a200_xdc"],
    tags = ["manual"],
)

vivado_program_device(
    name = "vreteno_board_jtag_prog",
    prog_daemon = "//cpu/vreteno/board/remote:hw_server",
    deps = [":vreteno_board_jtag_pnr"],
    tags = ["manual"],
)

# The bus from the cable: words written into the data memory and the
# DDR3 through the JTAG master and read back, and the timer read
# twice, from Vivado's hardware manager against the board. The
# hardware server is at localhost:3122, as the programming targets
# expect; HOSTPORT in the environment says otherwise.
#
#   bazel run //cpu/vreteno/board/remote:hw_server
#   bazel run //cpu/vreteno:vreteno_board_jtag_probe
vivado_repl(
    name = "vreteno_board_jtag_probe",
    data = [":vreteno_board_jtag_pnr"],
    script = "board/jtag/probe.tcl",
    use_terminal = False,
    tags = ["manual"],
)

# The debug module from the cable (issue 154): halt the core, read its
# registers by the abstract command, resume it. Same bitstream, any
# program running.
#
#   bazel run //cpu/vreteno:vreteno_board_dm_probe
vivado_repl(
    name = "vreteno_board_dm_probe",
    data = [":vreteno_board_jtag_pnr"],
    script = "board/jtag/dm_probe.tcl",
    use_terminal = False,
    tags = ["manual"],
)

# The instruction cache (issue 1021): a loop fetched from the data
# memory runs from the cache, and code stored and fenced with
# `fence.i` is what runs.
rust_test(
    name = "icache_test",
    srcs = ["tests/icache.rs"],
    edition = "2021",
    deps = [":vreteno32"],
)
