# Vreteno: an RV32IM core in TxHDL. The library holds the core, the
# ISA, the reference model and the programs; the binary runs the
# demonstration and writes its waveform; the test runs the core
# against the model in lockstep.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "vreteno32",
    srcs = [
        "src/board.rs",
        "src/core.rs",
        "src/dmem.rs",
        "src/rom.rs",
        "src/isa.rs",
        "src/lib.rs",
        "src/model.rs",
        "src/pair.rs",
        "src/program.rs",
        "src/run.rs",
        "src/term.rs",
        "src/timer.rs",
        "src/uart.rs",
    ],
    crate_name = "vreteno32",
    edition = "2021",
    deps = [
        "//ddr3",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

