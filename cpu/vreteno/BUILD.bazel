# Every compressed halfword, disassembled by the GNU tools the build
# fetches, for the test below to read.
genrule(
    name = "compressed_listing",
    outs = ["compressed.txt"],
    cmd = """
        t=$$(mktemp -d)
        {
            echo '.option rvc'
            echo '.text'
            i=0
            while [ $$i -lt 65536 ]; do
                if [ $$((i & 3)) -ne 3 ]; then
                    printf '.insn 0x%04x\\n' $$i
                fi
                i=$$((i + 1))
            done
        } > $$t/all.S
        $(location @riscv_none_elf_gcc//:as) -march=rv32imc -o $$t/all.o $$t/all.S
        $(location @riscv_none_elf_gcc//:objdump) -d -M no-aliases,numeric $$t/all.o > $@
        rm -rf $$t
    """,
    tools = [
        "@riscv_none_elf_gcc//:as",
        "@riscv_none_elf_gcc//:objdump",
    ],
)

# Fastboot's copy-and-jump (issue 143), assembled from the file the
# Zephyr image builds, as the bytes of the routine alone.
genrule(
    name = "fastboot_jump_bin",
    srcs = ["//zephyr:fastboot/app/src/jump.S"],
    outs = ["fastboot_jump.bin"],
    cmd = """
        t=$$(mktemp -d)
        $(location @riscv_none_elf_gcc//:as) -march=rv32imc -o $$t/j.o $<
        $(location @riscv_none_elf_gcc//:objcopy) -O binary -j .text.fb_jump $$t/j.o $@
        rm -rf $$t
    """,
    tools = [
        "@riscv_none_elf_gcc//:as",
        "@riscv_none_elf_gcc//:objcopy",
    ],
)

