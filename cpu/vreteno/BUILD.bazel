    name = "board_netlist",
    srcs = ["src/bin/board_netlist.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//cpu/vreteno/rust:boot_program",
        "//cpu/vreteno/rust:ddr3_board_program",
        "//cpu/vreteno/rust:ddr3_program",
        "//cpu/vreteno/rust:fade_program",
