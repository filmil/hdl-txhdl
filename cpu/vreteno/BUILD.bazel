# Synthesis of the core's Verilog, as the document build wrote it, on an
# Artix-7 part, with the hermetic Vivado. Manual: a cold run installs
# Vivado first, about 300 GB of transient disk and an hour or two.
#
#   bazel build //cpu/vreteno:vreteno_synth
load(
    "@rules_vivado//build/vivado:rules.bzl",
    "vivado_ila",
    "vivado_ip",
    "vivado_program_device",
    "vivado_program_flash",
    "vivado_project",
    "vivado_read_ila",
    "vivado_repl",
    "vivado_synthesis",
)
load("//tools/vivado:defs.bzl", "vivado_place_and_route2", "vivado_synthesis2")

vivado_project(
    name = "vreteno_project",
    srcs = ["//docs:vreteno.v"],
    part = "xc7a200tfbg484-2",
    top_level = "vreteno",
    xdcs = ["vreteno.xdc"],
    tags = ["manual"],
)

vivado_synthesis(
    name = "vreteno_synth",
    project = ":vreteno_project",
    tags = ["manual"],
)

# Implementation: synthesis again through the newer rule, which writes
# its timing summary, then place and route with the timing summary,
# the utilization and the DRC report of the routed design. The core is
# synthesised out of context, so its ports are the partition's pins and
# not pads: with the debug port it has more ports than the package has
# pins, and placement failed on them (issue 971). The constraints name
# the clock and no pins, so the bitstream is a stub; the reports are the
# point.
#
#   bazel build //cpu/vreteno:vreteno_pnr
filegroup(
    name = "vreteno_xdc",
    srcs = ["vreteno.xdc"],
)

vivado_synthesis2(
    name = "vreteno_synth2",
    srcs = ["//docs:vreteno.v"],
    part = "xc7a200tfbg484-2",
    synth_design_options = "-mode out_of_context",
    top = "vreteno",
    xdcs = [":vreteno_xdc"],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "vreteno_pnr",
    synthesis = ":vreteno_synth2",
    # No pins, so the bitstream is the stub the comment above names:
    # under rules_vivado 3.16 a failed write_bitstream fails the build
    # unless the target opts in (issue 967).
    placeholder_bitstream = True,
    xdcs = [":vreteno_xdc"],
    # vivado_ci: the nightly Vivado job builds it (#1030).
    tags = [
        "manual",
        "vivado_ci",
    ],
)

