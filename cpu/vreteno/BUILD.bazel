filegroup(
    name = "sources",
    srcs = glob([
        "src/*.rs",
        "src/bin/*.rs",
        "tests/*.rs",
        "board/*.v",
        "board/jtag/*.tcl",
        # The program compiled for the core and its linker script are
        # a package of their own, so they come by label rather than by
        # a glob, which cannot cross a package boundary.
    ]) + [
        "//cpu/vreteno/rust:sources",
        "//cpu/vreteno/cpp:sources",
    ],
)

# Synthesis of the core's Verilog, as the document build wrote it, on an
# Artix-7 part, with the hermetic Vivado. Manual: a cold run installs
# Vivado first, about 300 GB of transient disk and an hour or two.
#
#   bazel build //cpu/vreteno:vreteno_synth
load(
    "@rules_vivado//build/vivado:rules.bzl",
    "vivado_place_and_route2",
    "vivado_ila",
    "vivado_ip",
    "vivado_program_device",
    "vivado_program_flash",
    "vivado_project",
    "vivado_read_ila",
    "vivado_repl",
    "vivado_synthesis",
)
load("//tools/vivado:defs.bzl", "vivado_synthesis2")

vivado_project(
    name = "vreteno_project",
    srcs = ["//docs:vreteno.v"],
    part = "xc7a200tfbg484-2",
    top_level = "vreteno",
    xdcs = ["vreteno.xdc"],
    tags = ["manual"],
)

vivado_synthesis(
    name = "vreteno_synth",
    project = ":vreteno_project",
    tags = ["manual"],
)

# Implementation: synthesis again through the newer rule, which writes
# its timing summary, then place and route with the timing summary,
# the utilization and the DRC report of the routed design. The
# constraints name the clock and no pins, so the bitstream is a stub;
# the reports are the point.
#
#   bazel build //cpu/vreteno:vreteno_pnr
filegroup(
    name = "vreteno_xdc",
    srcs = ["vreteno.xdc"],
)

vivado_synthesis2(
    name = "vreteno_synth2",
    srcs = ["//docs:vreteno.v"],
    part = "xc7a200tfbg484-2",
    top = "vreteno",
    xdcs = [":vreteno_xdc"],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "vreteno_pnr",
    synthesis = ":vreteno_synth2",
    xdcs = [":vreteno_xdc"],
    tags = ["manual"],
)

# The board on the Alinx AX7A200: the lowered design with the DDR3 test
# in its memories, UberDDR3's controller, and the hand-written top with
# the PLL, the resets and the pins. The constraints name the board's
# pins, the memory's among them, so this bitstream is real. Manual, as
# every Vivado target is.
#
#   bazel build //cpu/vreteno:vreteno_board_pnr
filegroup(
    name = "ax7a200_xdc",
    srcs = [
        "board/ax7a200.xdc",
        "board/ax7a200_ddr3.xdc",
    ],
)

vivado_synthesis2(
    name = "vreteno_board_synth",
    # UberDDR3's RTL sets default_nettype none, which lasts into every
    # file read after it, so the controller goes last.
    srcs = [
        ":board_v",
        "board/vreteno_board.v",
        "//ddr3:hdl",
    ],
    part = "xc7a200tfbg484-2",
    top = "vreteno_board",
    xdcs = [":ax7a200_xdc"],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "vreteno_board_pnr",
    synthesis = ":vreteno_board_synth",
    xdcs = [":ax7a200_xdc"],
    tags = ["manual"],
)

