# Vreteno: an RV32IM core in TxHDL. The library holds the core, the
# ISA, the reference model and the programs; the binary runs the
# demonstration and writes its waveform; the test runs the core
# against the model in lockstep.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "vreteno32",
    srcs = [
        "src/board.rs",
        "src/core.rs",
        "src/dmem.rs",
        "src/isa.rs",
        "src/lib.rs",
        "src/model.rs",
        "src/program.rs",
        "src/run.rs",
        "src/term.rs",
        "src/timer.rs",
        "src/uart.rs",
    ],
    crate_name = "vreteno32",
    edition = "2021",
    deps = [
        "//ddr3",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

# The board's design as one lowered unit, on the programs compiled for
# the core, and its netlist with the DDR3 controller in it.
rust_test(
    name = "board_test",
    srcs = ["tests/board.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//cpu/vreteno/rust:ddr3_program",
        "//cpu/vreteno/rust:hello_program",
        "//lib:txhdl",
    ],
)

# The board's netlist with the DDR3 test in its memories, for a
# simulation (`sim`) or for the board (`board`):
#   bazel run //cpu/vreteno:board_netlist -- sim
rust_binary(
    name = "board_netlist",
    srcs = ["src/bin/board_netlist.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//cpu/vreteno/rust:ddr3_program",
        "//lib:txhdl",
    ],
)

genrule(
    name = "board_sim_v",
    outs = ["board_sim.v"],
    cmd = "$(location :board_netlist) sim > $@",
    tools = [":board_netlist"],
)

genrule(
    name = "board_v",
    outs = ["board.v"],
    cmd = "$(location :board_netlist) board > $@",
    tools = [":board_netlist"],
)

# The encoders against the decoder.
rust_test(
    name = "isa_test",
    crate = ":vreteno32",
    edition = "2021",
)

# Run the demonstration:  bazel run //cpu/vreteno
rust_binary(
    name = "vreteno",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
)

# Rust compiled for the core, run on it: the hello world of issue 79.
#   bazel run //cpu/vreteno:hello
rust_binary(
    name = "hello",
    srcs = ["src/bin/hello.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//cpu/vreteno/rust:hello_program",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
)

# The same run as a test, so the toolchain and the core are checked
# together by `bazel test //...` and not only by hand.
rust_test(
    name = "hello_test",
    crate = ":hello",
    edition = "2021",
)

# The same, in C++: the other toolchain, the same core.
#   bazel run //cpu/vreteno:hello_cc
rust_binary(
    name = "hello_cc",
    srcs = ["src/bin/hello_cc.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//cpu/vreteno/cpp:hello_cc_program",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
)

rust_test(
    name = "hello_cc_test",
    crate = ":hello_cc",
    edition = "2021",
)

# The core against the model, every cycle.
rust_test(
    name = "lockstep",
    srcs = ["tests/lockstep.rs"],
    edition = "2021",
    deps = [
        ":vreteno32",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
)

filegroup(
    name = "sources",
    srcs = glob([
        "src/*.rs",
        "src/bin/*.rs",
        "tests/*.rs",
        "board/*.v",
        # The program compiled for the core and its linker script are
        # a package of their own, so they come by label rather than by
        # a glob, which cannot cross a package boundary.
    ]) + [
        "//cpu/vreteno/rust:sources",
        "//cpu/vreteno/cpp:sources",
    ],
)

# Synthesis of the core's Verilog, as the document build wrote it, on an
# Artix-7 part, with the hermetic Vivado. Manual: a cold run installs
# Vivado first, about 300 GB of transient disk and an hour or two.
#
#   bazel build //cpu/vreteno:vreteno_synth
load(
    "@rules_vivado//build/vivado:rules.bzl",
    "vivado_place_and_route2",
    "vivado_program_device",
    "vivado_program_flash",
    "vivado_project",
    "vivado_synthesis",
    "vivado_synthesis2",
)

vivado_project(
    name = "vreteno_project",
    srcs = ["//docs:vreteno.v"],
    part = "xc7a200tfbg484-2",
    top_level = "vreteno",
    xdcs = ["vreteno.xdc"],
    tags = ["manual"],
)

vivado_synthesis(
    name = "vreteno_synth",
    project = ":vreteno_project",
    tags = ["manual"],
)

# Implementation: synthesis again through the newer rule, which writes
# its timing summary, then place and route with the timing summary,
# the utilization and the DRC report of the routed design. The
# constraints name the clock and no pins, so the bitstream is a stub;
# the reports are the point.
#
#   bazel build //cpu/vreteno:vreteno_pnr
filegroup(
    name = "vreteno_xdc",
    srcs = ["vreteno.xdc"],
)

vivado_synthesis2(
    name = "vreteno_synth2",
    srcs = ["//docs:vreteno.v"],
    part = "xc7a200tfbg484-2",
    top = "vreteno",
    xdcs = [":vreteno_xdc"],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "vreteno_pnr",
    synthesis = ":vreteno_synth2",
    xdcs = [":vreteno_xdc"],
    tags = ["manual"],
)

# The board on the Alinx AX7A200: the lowered design with the DDR3 test
# in its memories, UberDDR3's controller, and the hand-written top with
# the PLL, the resets and the pins. The constraints name the board's
# pins, the memory's among them, so this bitstream is real. Manual, as
# every Vivado target is.
#
#   bazel build //cpu/vreteno:vreteno_board_pnr
filegroup(
    name = "ax7a200_xdc",
    srcs = [
        "board/ax7a200.xdc",
        "board/ax7a200_ddr3.xdc",
    ],
)

vivado_synthesis2(
    name = "vreteno_board_synth",
    # UberDDR3's RTL sets default_nettype none, which lasts into every
    # file read after it, so the controller goes last.
    srcs = [
        ":board_v",
        "board/vreteno_board.v",
        "//ddr3:hdl",
    ],
    part = "xc7a200tfbg484-2",
    top = "vreteno_board",
    xdcs = [":ax7a200_xdc"],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "vreteno_board_pnr",
    synthesis = ":vreteno_board_synth",
    xdcs = [":ax7a200_xdc"],
    tags = ["manual"],
)

# Program the board where it is, on the machine .bazelrc names in
# TXHDL_BOARD_SERVER: the daemon brings hw_server up there and a tunnel
# here, //cpu/vreteno/board/remote says how; then Vivado connects to
# the tunnel. Bring the tunnel up first, since the daemon is started
# beside the connection, not before it:
#
#   bazel run //cpu/vreteno/board/remote:hw_server
#   bazel run //cpu/vreteno:vreteno_board_prog -- \
#       --hostport localhost:3122 --device '*/xilinx_tcf/Digilent/*'
#
# This writes the FPGA itself, which the next power cycle forgets.
vivado_program_device(
    name = "vreteno_board_prog",
    prog_daemon = "//cpu/vreteno/board/remote:hw_server",
    deps = [":vreteno_board_pnr"],
    tags = ["manual"],
)

# Write the bitstream into the board's QSPI flash, a Micron MT25QL256
# over a 4-bit bus, as the a200t examples do; the same tunnel:
#
#   bazel run //cpu/vreteno:vreteno_board_flash -- \
#       --hostport localhost:3122 --device '*/xilinx_tcf/Digilent/*'
vivado_program_flash(
    name = "vreteno_board_flash",
    size = 32,
    flash_part = "mt25ql256-spi-x1_x2_x4",
    interface = "SPIx4",
    deps = [":vreteno_board_pnr"],
    tags = ["manual"],
)
