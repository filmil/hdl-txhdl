# SPDX-License-Identifier: Apache-2.0
# The DDR3 memory's pins on the Alinx AX7A200: their package pins, their
# I/O standards, fast slew on the outputs and split termination on the
# inputs. Copied unchanged below this header from ip/a200t/a200t_ddr3.xdc
# of the a200t_examples repository (Apache-2.0), where UberDDR3 runs on
# this board with these constraints; the port names are the ones the
# board top uses.
############## DDR3 ##################
# DQ PINS
set_property SLEW FAST [get_ports {ddr3_dq_p[0]}]
set_property IN_TERM UNTUNED_SPLIT_50 [get_ports {ddr3_dq_p[0]}]
set_property SLEW FAST [get_ports {ddr3_dq_p[1]}]
set_property IN_TERM UNTUNED_SPLIT_50 [get_ports {ddr3_dq_p[1]}]
