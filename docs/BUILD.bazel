# The project's timeline, drawn from the data `//tools/timeline`
# extracted from the repository's own history. The extraction is by
# hand, because a Bazel action has no repository to read; the drawing
# is the build's, so the chart in the document is never a picture
# somebody pasted in.
genrule(
    name = "gantt_tex",
    srcs = ["timeline.tsv"],
    outs = ["gantt.tex"],
    cmd = "$(location //tools/gantt) $(location timeline.tsv) > $@",
    tools = ["//tools/gantt"],
)

# The numbers the document quotes, as TeX macros, so its prose cannot
# drift from the chart beside it.
genrule(
    name = "timeline_counts",
    srcs = ["timeline.tsv"],
    outs = ["timeline_counts.tex"],
    cmd = "$(location //tools/gantt) --counts $(location timeline.tsv) > $@",
    tools = ["//tools/gantt"],
)

