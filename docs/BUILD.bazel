# The placed core, drawn from the grid the ASIC flow wrote. The layout
# itself is `//cpu/vreteno/asic:vreteno_pnr`, which is manual because
# it is twenty minutes of work; what it writes is two small files, and
# those are committed, exactly as the timeline's data is.
genrule(
    name = "asicmap_tex",
    srcs = ["asic_map.tsv"],
    outs = ["asicmap.tex"],
    cmd = "$(location //tools/denmap) $(location asic_map.tsv) > $@",
    tools = ["//tools/denmap"],
)

# The numbers that run produced, as TeX macros, so the prose beside
# the table cannot drift from it.
genrule(
