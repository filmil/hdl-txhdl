# The specification as an IEEE two-column article, set in Computer Modern.
# Built against the hermetic LaTeX toolchain registered in MODULE.bazel, so
# nothing has to be installed on the machine running the build.
# The build stamp: the commit and the day, from Bazel's workspace status
# (tools/workspace_status.sh), as \buildstamp for every document. A
# build outside Bazel has no file and falls back to a draft note.
genrule(
    name = "buildstamp",
    outs = ["buildstamp.tex"],
    cmd = "c=$$(grep '^STABLE_GIT_COMMIT ' bazel-out/stable-status.txt | cut -d' ' -f2);" +
          " t=$$(grep '^BUILD_TIMESTAMP ' bazel-out/volatile-status.txt | cut -d' ' -f2);" +
          " d=$$(date -u -d @$$t +%Y-%m-%d);" +
          " printf '\\\\newcommand{\\\\buildstamp}{Built by Bazel from commit" +
          " \\\\code{%s} on %s.}\\n' \"$$c\" \"$$d\" > $@",
    stamp = 1,
)

latex_document(
    name = "article",
    main = "article.tex",
    data = [
        ":buildstamp",
        ":vendored_tex",
    ],
    deps = ["housestyle.tex"] + glob(["sections/*.tex"]),
)

# The second article: what is left of the language once every construct
# Rust already provides is deleted. Shares the house preamble, so the
# documents cannot drift apart in font, listing style or figure style.
latex_document(
    name = "embedding",
    main = "embedding.tex",
    data = [
        ":buildstamp",
        ":vendored_tex",
    ],
    deps = ["housestyle.tex"] + glob(["embedding_sections/*.tex"]),
)

# The runtime: the library included verbatim from the tree, so a listing
# there cannot differ from the code.
latex_document(
    name = "runtime",
    main = "runtime.tex",
    data = [
        ":buildstamp",
        ":vendored_tex",
        "//lib:sources",
        "//lib/parts:sources",
    ],
    deps = ["housestyle.tex"] + glob(["runtime_sections/*.tex"]),
)

# The public interface of each runtime file, extracted from the source.
# The examples document shows the runtime through nothing else.
API = {
    "api_types.rs": "//lib:src/types.rs",
    "api_comp.rs": "//lib:src/comp.rs",
    "api_pipeline.rs": "//lib:src/pipeline.rs",
    "api_funcs.rs": "//lib:src/funcs.rs",
    "api_macros.rs": "//lib:macros/lib.rs",
    "api_netlist.rs": "//lib:src/netlist.rs",
    "api_foreign.rs": "//lib:src/foreign.rs",
    "api_buffer.rs": "//lib/parts:src/buffer.rs",
}

[
    genrule(
        name = out.replace(".rs", ""),
        srcs = [src],
        outs = [out],
        cmd = "$(location //tools/api) $(location " + src + ") > $@",
        tools = ["//tools/api"],
    )
    for out, src in API.items()
]

# What the examples that print printed. Run by the build, so the output
# under a listing is the output of the listing beside it.
genrule(
    name = "example_outputs",
    outs = [
        "out_config.txt",
        "out_fifo.txt",
        "out_arbiter.txt",
        "out_trace.txt",
    ],
    cmd = " && ".join([
        "$(location //lib/examples:ex_config) fpga > $(RULEDIR)/out_config.txt",
        "$(location //lib/examples:ex_config) asic >> $(RULEDIR)/out_config.txt",
        "$(location //lib/examples:ex_fifo) > $(RULEDIR)/out_fifo.txt",
        "$(location //lib/examples:ex_arbiter) > $(RULEDIR)/out_arbiter.txt",
        "$(location //lib/examples:ex_trace) > $(RULEDIR)/out_trace.txt",
    ]),
    tools = [
        "//lib/examples:ex_config",
        "//lib/examples:ex_fifo",
        "//lib/examples:ex_arbiter",
        "//lib/examples:ex_trace",
    ],
)

# The waveform of the trace example, drawn: VCD to a signals database
# (vcdcvt), the database to drawtiming text for the chosen signals
# (sqlite2drawtiming), the text to TikZ (//tools/dt2tikz). The two
# converters are prebuilt tools pinned in //:multitool.lock.json.
genrule(
    name = "counter_db",
    srcs = ["out_trace.txt"],
    outs = ["counter.db"],
    cmd = "$(location @multitool//tools/vcdcvt) -logtostderr" +
          " -in $(location out_trace.txt) -format sqlite -out $@",
    tools = ["@multitool//tools/vcdcvt"],
)

genrule(
    name = "counter_dt",
    srcs = ["counter.db"],
    outs = ["counter.dt"],
    cmd = "$(location @multitool//tools/sqlite2drawtiming) -logtostderr" +
          " -in $(location counter.db) -ndots 1" +
          " -signal '//clocks/clk=>clk'" +
          " -signal '//counter/n=>n'" +
          " -signal '//counter/phase=>phase'" +
          " -signal '//msb=>msb' > $@",
    tools = ["@multitool//tools/sqlite2drawtiming"],
)

genrule(
    name = "counter_timing",
    srcs = ["counter.dt"],
    outs = ["counter_timing.tex"],
    cmd = "$(location //tools/dt2tikz) $(location counter.dt)" +
          " --order clk,n,phase,msb --color > $@",
    tools = ["//tools/dt2tikz"],
)

