    "api_comp.rs": "//lib:src/comp.rs",
    "api_pipeline.rs": "//lib:src/pipeline.rs",
    "api_funcs.rs": "//lib:src/funcs.rs",
    "api_macros.rs": "//lib:macros/lib.rs",
    "api_netlist.rs": "//lib:src/netlist.rs",
    "api_foreign.rs": "//lib:src/foreign.rs",
    "api_buffer.rs": "//lib/parts:src/buffer.rs",
    "api_fifo.rs": "//lib/parts:src/fifo.rs",
    "api_station.rs": "//lib/parts:src/station.rs",
}

[
    genrule(
        name = out.replace(".rs", ""),
        srcs = [src],
        outs = [out],
        cmd = "$(location //tools/api) $(location " + src + ") > $@",
        tools = ["//tools/api"],
    )
    for out, src in API.items()
]

# What the examples that print printed. Run by the build, so the output
# under a listing is the output of the listing beside it.
genrule(
    name = "example_outputs",
    outs = [
        "out_config.txt",
        "out_fifo.txt",
        "out_arbiter.txt",
        "out_trace.txt",
    ],
    cmd = " && ".join([
        "$(location //lib/examples:ex_config) fpga > $(RULEDIR)/out_config.txt",
        "$(location //lib/examples:ex_config) asic >> $(RULEDIR)/out_config.txt",
        "$(location //lib/examples:ex_fifo) > $(RULEDIR)/out_fifo.txt",
        "$(location //lib/examples:ex_arbiter) > $(RULEDIR)/out_arbiter.txt",
        "$(location //lib/examples:ex_trace) > $(RULEDIR)/out_trace.txt",
    ]),
    tools = [
        "//lib/examples:ex_config",
        "//lib/examples:ex_fifo",
        "//lib/examples:ex_arbiter",
        "//lib/examples:ex_trace",
    ],
)

# The waveform of the trace example, drawn: VCD to a signals database
# (vcdcvt), the database to drawtiming text for the chosen signals
# (sqlite2drawtiming), the text to TikZ (//tools/dt2tikz). The two
# converters are prebuilt tools pinned in //:multitool.lock.json.
genrule(
    name = "counter_db",
    srcs = ["out_trace.txt"],
    outs = ["counter.db"],
    cmd = "$(location @multitool//tools/vcdcvt) -logtostderr" +
          " -in $(location out_trace.txt) -format sqlite -out $@",
    tools = ["@multitool//tools/vcdcvt"],
)

genrule(
    name = "counter_dt",
    srcs = ["counter.db"],
    outs = ["counter.dt"],
    cmd = "$(location @multitool//tools/sqlite2drawtiming) -logtostderr" +
          " -in $(location counter.db) -ndots 1" +
          " -signal '//clocks/clk=>clk'" +
          " -signal '//counter/n=>n'" +
          " -signal '//counter/phase=>phase'" +
          " -signal '//msb=>msb' > $@",
    tools = ["@multitool//tools/sqlite2drawtiming"],
)

genrule(
    name = "counter_timing",
    srcs = ["counter.dt"],
    outs = ["counter_timing.tex"],
    cmd = "$(location //tools/dt2tikz) $(location counter.dt)" +
          " --order clk,n,phase,msb --color > $@",
    tools = ["//tools/dt2tikz"],
)

