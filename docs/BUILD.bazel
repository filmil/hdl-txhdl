        "//lib/examples:sources",
    ],
    deps = ["housestyle.tex"],
)

genrule(
    name = "cheatsheet_png",
    srcs = [":cheatsheet"],
    outs = ["cheatsheet.png"],
    cmd = "$(location @hermetic_latex_ghostscript//:gs.sh) -dBATCH -dNOPAUSE -q" +
          " -sDEVICE=png16m -r150 -dTextAlphaBits=4 -dGraphicsAlphaBits=4" +
          " -sOutputFile=$@ $(location :cheatsheet)",
    tools = [
        "@hermetic_latex_ghostscript//:files",
        "@hermetic_latex_ghostscript//:gs.sh",
    ],
)

# Every document in sequence, one file, with a bookmark per document.
combined_pdf(
    name = "all",
    out = "txhdl.pdf",
    bookmarks = [
        "TxHDL Documents",
        "TxHDL cheat sheet",
        "TxHDL: Unifying a Dataflow and a Transaction HDL",
        "Deleting a Language: Embedding TxHDL in Rust",
        "The TxHDL Runtime",
        "TxHDL by Example",
        "Vreteno: An RV32I Core in TxHDL",
    ],
    parts = [
        ":cover",
        ":cheatsheet",
        ":article",
        ":embedding",
        ":runtime",
        ":examples",
        ":vreteno",
    ],
)
