# What `station!` wrote for the two-input station, as the example
# prints it, and the size of that text beside the hand-written
# Verilog's: both for the tutorial, neither typed by hand.
# What `lite_bridge!` wrote for a bridge of two peripherals, as the
# example prints it, for the AXI document.
genrule(
    name = "plic_source",
    outs = ["plic3.rs"],
    cmd = "$(location //lib/examples:ex_plic) --source > $@",
    tools = ["//lib/examples:ex_plic"],
)

genrule(
    name = "lite_bridge_source",
    outs = ["lite_bridge2.rs"],
    cmd = "$(location //lib/examples:ex_axi_lite) --source > $@",
    tools = ["//lib/examples:ex_axi_lite"],
)

genrule(
    name = "router_source",
    outs = ["router3.rs"],
    cmd = "$(location //lib/examples:ex_axi_router) --source > $@",
    tools = ["//lib/examples:ex_axi_router"],
)

genrule(
    name = "station_source",
    outs = [
        "station2.rs",
        "station2_marked.rs",
    ],
    cmd = " && ".join([
        "$(location //lib/examples:ex_station) --source " +
        "> $(location station2_marked.rs)",
        "grep -v '^// \\(begin\\|end\\){' $(location station2_marked.rs) " +
        "> $(location station2.rs)",
    ]),
    tools = ["//lib/examples:ex_station"],
)

genrule(
    name = "station_sizes",
    srcs = [
        ":station2.rs",
        "//lib/examples:station.v",
    ],
    outs = ["station_sizes.txt"],
    cmd = " && ".join([
        "echo \"lines  file\" > $@",
        "wc -l < $(location //lib/examples:station.v) | " +
        "xargs printf '%5d  station.v, by hand\\n' >> $@",
        "grep -v '^ *//' $(location :station2.rs) | wc -l | " +
        "xargs printf '%5d  station2.rs, as station! wrote it, comments left out\\n' >> $@",
        "grep -v '^ *//' $(location //lib/examples:station.v) | wc -l | " +
        "xargs printf '%5d  station.v, comments left out\\n' >> $@",
    ]),
)

