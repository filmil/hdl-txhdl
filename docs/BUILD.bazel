# The paper's and the tutorial's waveforms, at column width.
[
    genrule(
        name = "paper_" + name + "_timing",
        srcs = [name + ".dt", name + ".fst.names"],
        outs = ["paper_" + name + "_timing.tex"],
        cmd = "$(location //tools/dt2tikz) $(location " + name + ".dt)" +
              " --order " + order + " --only --color --width 7.0" + extra +
              " --names $(location " + name + ".fst.names)" +
              " --signals '" + signals + "' > $@",
        tools = ["//tools/dt2tikz"],
    )
    for name, order, signals, extra in [
        (
            "cheat",
            "clk,enable,n,tick",
            "//clocks/clk=>clk,//enable=>enable,//counter/n=>n,//tick=>tick",
            "",
        ),
        (
            "stage",
            "clk,inp_valid,inp,inp_ready,out_valid,out,count",
            "//clocks/clk=>clk,//inp/rx_valid=>inp_valid,//inp/rx_data=>inp," +
            "//inp/rx_ready=>inp_ready,//out/tx_valid=>out_valid," +
            "//out/tx_data=>out,//stage/count=>count",
            "",
        ),
        (
            "case",
            "clk,go,state,count,observed",
            "//clocks/clk=>clk,//go=>go,//sequencer/state=>state," +
            "//sequencer/count=>count,//observed=>observed",
            "",
        ),
        (
            "vreteno_out",
            "clk,ureq_valid,tx",
            "//clocks/clk=>clk,//ureq/rx_valid=>ureq_valid,//tx=>tx",
            " --from 430 --until 522",
        ),
        (
            "vreteno",
            "clk,rst,pc,done,rd,val",
            "//clocks/clk=>clk,//rst=>rst,//cpu/pc=>pc," +
            "//wb/done=>done,//wb/rd=>rd,//wb/val=>val",
            " --until 22",
        ),
    ]
]

