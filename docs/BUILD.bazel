    srcs = [
        "asic_map.tsv",
        "asic.tsv",
    ],
    outs = ["asic_counts.tex"],
    cmd = "$(location //tools/denmap) --counts $(location asic_map.tsv) " +
          "$(location asic.tsv) > $@",
