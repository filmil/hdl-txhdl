# SPDX-License-Identifier: Apache-2.0
# Ethernet on the Alinx AX7A200: the two halves of the MAC from
# //lib/parts, lowered, inside a hand-written echo design with the PHY's
# RGMII, the clocks and the crossing between them.
load("@rules_rust//rust:defs.bzl", "rust_binary")
load(
    "@rules_vivado//build/vivado:rules.bzl",
    "vivado_place_and_route2",
    "vivado_program_device",
    "vivado_synthesis2",
)

package(default_visibility = ["//visibility:public"])

# The Verilog of `eth_rx` and `eth_tx`.
rust_binary(
    name = "netlist",
    srcs = ["src/netlist.rs"],
    edition = "2021",
    deps = ["//lib/parts:txhdl_parts"],
)

genrule(
    name = "mac_v",
    outs = ["eth_mac.v"],
    cmd = "$(location :netlist) > $@",
    tools = [":netlist"],
)

filegroup(
    name = "echo_xdc",
    srcs = [
        "board/ax7a200_eth.xdc",
        ":eth_pins",
    ],
)

# The PHY's pins, which every design that drives the port reads.
filegroup(
    name = "eth_pins",
    srcs = ["board/eth_pins.xdc"],
)

# The PHY's two edges, likewise.
filegroup(
    name = "eth_rgmii",
    srcs = ["board/eth_rgmii.v"],
)

# The echo design through Vivado's synthesis, and then through place and
# route with the board's pins to a bitstream. Manual, as every Vivado
# target is:
#
#   bazel build //eth:echo_synth
#   bazel build //eth:echo_pnr
vivado_synthesis2(
    name = "echo_synth",
    srcs = [
        ":mac_v",
        "//lib/board:chan_cdc",
        "board/eth_rgmii.v",
        "board/eth_echo.v",
    ],
    part = "xc7a200tfbg484-2",
    top = "eth_echo",
    xdcs = [":echo_xdc"],
    tags = ["manual"],
)

vivado_place_and_route2(
    name = "echo_pnr",
    synthesis = ":echo_synth",
    xdcs = [":echo_xdc"],
    tags = ["manual"],
)

# Write the echo design into the board where it is, over the tunnel the
# Vreteno board's daemon opens. Bring the tunnel up first:
#
#   bazel run //cpu/vreteno/board/remote:hw_server
#   bazel run //eth:echo_prog -- \
#       --hostport localhost:3122 --device '*/xilinx_tcf/Digilent/*'
#
# This writes the FPGA itself, which the next power cycle forgets.
vivado_program_device(
    name = "echo_prog",
    prog_daemon = "//cpu/vreteno/board/remote:hw_server",
    deps = [":echo_pnr"],
    tags = ["manual"],
)

# The sources by name, for the documents' listings.
filegroup(
    name = "sources",
    srcs = glob(["board/*.v", "board/*.xdc", "src/*.rs"]),
)
