load("@bazel_ebook//build:rules.bzl", "ebook_pdf", "markdown_lib", "pandoc_standalone_html")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "empty_xml_gen",
    outs = ["empty_gen.xml"],
    cmd = "touch $@",
)

markdown_lib(
    name = "draft_spec_md",
    srcs = ["draft-spec.md"],
)

ebook_pdf(
    name = "draft-spec-pdf",
    metadata_xml = ":empty_xml_gen",
    title_yaml = "empty.yaml",
    tags = ["pdf"],
    deps = ["//:empty_md", ":draft_spec_md"],
)

pandoc_standalone_html(
    name = "draft-spec-html",
    tags = ["html"],
    deps = ["//:empty_md", ":draft_spec_md"],
)

markdown_lib(
    name = "spec_md",
    srcs = ["spec.md"],
)

ebook_pdf(
    name = "spec-pdf",
    metadata_xml = ":empty_xml_gen",
    title_yaml = "empty.yaml",
    tags = ["pdf"],
    deps = ["//:empty_md", ":spec_md"],
)

pandoc_standalone_html(
    name = "spec-html",
    tags = ["html"],
    deps = ["//:empty_md", ":spec_md"],
)

markdown_lib(
    name = "lhdl_proposal_md",
    srcs = ["lhdl-proposal.md"],
)

ebook_pdf(
    name = "lhdl-proposal-pdf",
    metadata_xml = ":empty_xml_gen",
    title_yaml = "empty.yaml",
    tags = ["pdf"],
    deps = ["//:empty_md", ":lhdl_proposal_md"],
)

pandoc_standalone_html(
    name = "lhdl-proposal-html",
    tags = ["html"],
    deps = ["//:empty_md", ":lhdl_proposal_md"],
)

markdown_lib(
    name = "readme_md",
    srcs = ["README.md"],
)

ebook_pdf(
    name = "readme-pdf",
    metadata_xml = ":empty_xml_gen",
    title_yaml = "empty.yaml",
    tags = ["pdf"],
    deps = ["//:empty_md", ":readme_md"],
)

pandoc_standalone_html(
    name = "readme-html",
    tags = ["html"],
    deps = ["//:empty_md", ":readme_md"],
)
