# The theses and the LHDL texts this language came from, as texts
# another module may quote at a pinned commit:
# `@txhdl//filmil:theses.md`, `@txhdl//filmil:workspace/spec.md`, or
# `@txhdl//filmil:sources` for all of them (issue 838).
package(default_visibility = ["//visibility:public"])

exports_files(glob(["**/*.md"]))

filegroup(
    name = "sources",
    srcs = glob(["**/*.md"]),
)
