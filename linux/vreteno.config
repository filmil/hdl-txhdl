# SPDX-License-Identifier: Apache-2.0
# The kernel for Vreteno, over tinyconfig (issue 1074): only what the
# board and the whole-machine model (issue 1016) have, what a BusyBox
# initramfs needs, and what a fuller system asks for (issue 1441): all
# of those together are 3,912,704 bytes of Image, +845,824, and 320 ms
# more to userspace on the model, 9.97 s against 9.65. The rv32 defconfig, cut down, stayed at
# 25 MiB; fastboot loads 16 MiB with the initramfs.
#
# The machine: one 32-bit hart with C and soon A (issue 1010), no
# floating point, Sv32 (issue 1014), the kernel in S mode under
# OpenSBI.
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# Sv32: the MMU on, since this is MMU Linux (issue 279).
CONFIG_MMU=y
CONFIG_SMP=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=n
CONFIG_RISCV_ISA_ZBB=n
CONFIG_RISCV_ISA_ZICBOM=n
CONFIG_RISCV_ISA_SVPBMT=n
# Loadable modules (issue 1441), for drivers a fuller system loads
# later: +172,544 bytes of Image, +31 ms to userspace on the model.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DEBUG_INFO_NONE=y
# The timer through SBI, which OpenSBI keeps on the CLINT; the PLIC's
# supervisor target (issue 1013); SiFive's serial port and its console
# (issue 1011), early too.
CONFIG_RISCV_TIMER=y
CONFIG_SIFIVE_PLIC=y
CONFIG_TTY=y
CONFIG_SERIAL_SIFIVE=y
CONFIG_SERIAL_SIFIVE_CONSOLE=y
# earlycon on sifive,uart0, which the console selects; the bootargs in
# the device tree (issue 1019) say `earlycon`.
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
# An initramfs of BusyBox (issue 1018): the cpio, ELF and scripts, the
# file systems it mounts, and what its applets ask of the kernel.
CONFIG_BLK_DEV_INITRD=y
# The initramfs comes gzipped in the boot image (issue 1201).
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
# setitimer and alarm, which tinyconfig leaves out with the POSIX
# clocks and timers: BusyBox's ping paces itself with alarm(), and
# without it waited for good after its first reply, on the board and on
# the model alike (issue 1246).
CONFIG_POSIX_TIMERS=y
# The network (issue 1203): IPv4 over the Ethernet port, which Linux's
# own LiteEth driver drives, since the port's registers are LiteEth's at
# LiteX's offsets and its slots are the buffers the device tree reserves.
CONFIG_NET=y
CONFIG_INET=y
# IPv6 (issue 1441): +267,264 bytes, +144 ms to userspace on the
# model, the dearest option here.
CONFIG_IPV6=y
# Unix sockets stay: the C library's if_nametoindex asks through one,
# and `ip` finds eth0 by name that way.
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_LITEX=y
CONFIG_LITEX_LITEETH=y
# What the network brings by default and the board does not use, off,
# since every board load sends the kernel whole: ethtool over netlink
# and socket diagnostics.
CONFIG_ETHTOOL_NETLINK=n
CONFIG_INET_DIAG=n
# Packet sockets, which DHCP clients such as udhcpc need (issue 1441):
# +25,088 bytes, no measurable boot time.
CONFIG_PACKET=y
# A root file system over NFS from srv (issues 1441, 1438): the client,
# version 3, and the kernel's own DHCP to find its address and server
# before the root is mounted. NFS needs file locking. +272,896 bytes,
# +100 ms to userspace on the model.
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_FILE_LOCKING=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_ROOT_NFS=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# A console on the HDMI output (issues 1441, 1440): the framebuffer the
# device tree's simple-framebuffer node names, the virtual terminal on
# it, and a font. +50,688 bytes, +7 ms; nothing binds it until the
# device tree has the node.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
# What a Buildroot userspace with an ssh server asks of the kernel
# beyond BusyBox's (issues 1441, 1439), which tinyconfig leaves out:
# pseudo-terminals for sessions, and epoll, eventfd, signalfd, timerfd
# and inotify for its daemons. +49,152 bytes, +8 ms.
CONFIG_UNIX98_PTYS=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_INOTIFY_USER=y
