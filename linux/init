#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# The first program (issue 1018): mount what the shell needs, say so on
# a line a test can wait for, run one command, and hand over to a shell.
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
# The devices, which the kernel mounts itself only on a root it mounted,
# not on an initramfs: the console's own tty is there, which the shell
# takes as its controlling tty below (issue 1249).
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox --install -s
echo "txhdl: userspace is up"
uname -a
# The network, as the command line asks for it. `txhdl.ip=ADDR/LEN`
# brings eth0 up at that address, which the board's image carries
# (issue 1318), and `txhdl.ping=HOST` pings a host and says whether it
# answered. `txhdl.net` is the two for the machine model (issue 1203):
# its peer is 10.0.0.2, and a ping it answers is the Ethernet port, its
# slots and Linux's litex_liteeth all working.
addr=
peer=
for word in $(/bin/busybox cat /proc/cmdline); do
	case "$word" in
	txhdl.net) addr=10.0.0.1/24 peer=10.0.0.2 ;;
	txhdl.ip=*) addr=${word#txhdl.ip=} ;;
	txhdl.ping=*) peer=${word#txhdl.ping=} ;;
	esac
done
if [ -n "$addr" ]; then
	/bin/busybox ip addr add "$addr" dev eth0
	/bin/busybox ip link set eth0 up
	echo "txhdl: eth0 is up at $addr"
fi
if [ -n "$addr" ] && [ -n "$peer" ]; then
	# Three, all answered: ping waits for each after the first with
	# alarm(), which the kernel had compiled out while one ping still
	# passed (issue 1246).
	pinged=$(/bin/busybox ping -c 3 -W 5 "$peer")
	echo "$pinged"
	case "$pinged" in
	*"3 packets received"*) echo "txhdl: network is up" ;;
	esac
fi
# A shell on the screen too, when there is one (issue 1440): the
# framebuffer console's first terminal, so a prompt shows on HDMI. Its
# input waits for a keyboard, or for ssh; the serial port's shell below
# is the one to type at.
if [ -c /dev/tty1 ]; then
	/bin/busybox setsid /bin/busybox sh -c \
		'exec /bin/busybox sh </dev/tty1 >/dev/tty1 2>&1' &
fi
# A dynamic program, when the root has musl's shared library (issue
# 1439): it loads through /lib/ld-musl-riscv32-sf.so.1 and says so.
if [ -x /bin/dynhello ]; then
	/bin/dynhello
fi
# The ssh server, when the root has one (issue 1439): its sessions need
# pseudo-terminals, and it makes its host keys on the first connection
# and keeps them in /etc/dropbear, which persists on an NFS root. Keys
# go in /root/.ssh/authorized_keys; no password is set.
if [ -x /usr/sbin/dropbear ]; then
	/bin/busybox mkdir -p /dev/pts /etc/dropbear
	/bin/busybox mount -t devpts devpts /dev/pts
	/usr/sbin/dropbear -R && echo "txhdl: dropbear is listening on 22"
fi
# The shell takes the console as its controlling tty, so that Ctrl-C
# reaches the command in the foreground: with a plain exec it had none,
# said "can't access tty", and a command that hung at the board's
# console could not be stopped (issue 1249). Only a session leader can
# take one, and this is process 1, which leads its process group and so
# cannot start a session, so the shell runs in a session of its own,
# where cttyhack opens the console's tty for it. Process 1 must not
# exit, so it waits for the shell, and starts another if it ends.
while :; do
	/bin/busybox setsid /bin/busybox cttyhack /bin/sh
done
