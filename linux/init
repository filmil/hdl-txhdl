#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# The first program (issue 1018): mount what the shell needs, say so on
# a line a test can wait for, run one command, and hand over to a shell.
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
# The devices, which the kernel mounts itself only on a root it mounted,
# not on an initramfs: the console's own tty is there, which the shell
# takes as its controlling tty below (issue 1249). On a root the kernel
# mounted, the NFS root's say, /dev is its devtmpfs already, and a second
# mount said "Resource busy" on every boot (issue 1455).
/bin/busybox grep -q ' /dev devtmpfs ' /proc/mounts ||
    /bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox --install -s
echo "txhdl: userspace is up"
uname -a
# The network, as the command line asks for it. `txhdl.ip=ADDR/LEN`
# brings eth0 up at that address, which the board's image carries
# (issue 1318), and `txhdl.ping=HOST` pings a host and says whether it
# answered. `txhdl.net` is the two for the machine model (issue 1203):
# its peer is 10.0.0.2, and a ping it answers is the Ethernet port, its
# slots and Linux's litex_liteeth all working.
addr=
peer=
ptycheck=
dhcp=
applets=
demo=
for word in $(/bin/busybox cat /proc/cmdline); do
	case "$word" in
	txhdl.net) addr=10.0.0.1/24 peer=10.0.0.2 ;;
	txhdl.ip=*) addr=${word#txhdl.ip=} ;;
	txhdl.ping=*) peer=${word#txhdl.ping=} ;;
	txhdl.ptycheck) ptycheck=1 ;;
	txhdl.dhcp) dhcp=1 ;;
	txhdl.applets) applets=1 ;;
	txhdl.demo) demo=2 ;;
	txhdl.demo=*) demo=${word#txhdl.demo=} ;;
	esac
done
if [ -n "$addr" ]; then
	/bin/busybox ip addr add "$addr" dev eth0
	/bin/busybox ip link set eth0 up
	echo "txhdl: eth0 is up at $addr"
fi
# `txhdl.dhcp` asks a DHCP server for eth0's address instead (issue
# 1441); the script udhcpc runs on a lease puts the address on, and
# what it was leased becomes the address the ping goes from.
if [ -n "$dhcp" ]; then
	/bin/busybox mkdir -p /etc
	/bin/busybox cat >/etc/udhcpc.script <<'EOF2'
#!/bin/sh
case "$1" in
bound | renew)
	/bin/busybox ip addr add "$ip/$mask" dev "$interface"
	echo "$ip/$mask" >/etc/leased
	;;
esac
EOF2
	/bin/busybox chmod 755 /etc/udhcpc.script
	/bin/busybox ip link set eth0 up
	if /bin/busybox udhcpc -i eth0 -n -q -t 5 -s /etc/udhcpc.script; then
		addr=$(/bin/busybox cat /etc/leased)
		echo "txhdl: eth0 leased $addr"
	else
		echo "txhdl: no DHCP lease for eth0"
	fi
fi
if [ -n "$addr" ] && [ -n "$peer" ]; then
	# Three, all answered: ping waits for each after the first with
	# alarm(), which the kernel had compiled out while one ping still
	# passed (issue 1246).
	pinged=$(/bin/busybox ping -c 3 -W 5 "$peer")
	echo "$pinged"
	case "$pinged" in
	*"3 packets received"*) echo "txhdl: network is up" ;;
	esac
fi
# Two threads, one on each hart, counting three ways (issue 1408).
if [ -x /bin/smpcount ]; then
	/bin/smpcount
fi
# A dynamic program, when the root has musl's shared library (issue
# 1439): it loads through /lib/ld-musl-riscv32-sf.so.1 and says so.
if [ -x /bin/dynhello ]; then
	/bin/dynhello
fi
# A module, when the root has one (issue 1441): loaded, listed and
# removed, which says the kernel loads modules; it says so as it goes.
if [ -f /lib/modules/txhdl_hello.ko ]; then
	/bin/busybox insmod /lib/modules/txhdl_hello.ko
	/bin/busybox lsmod | /bin/busybox grep txhdl_hello
	/bin/busybox rmmod txhdl_hello
fi
# The ssh server, when the root has one (issue 1439): its sessions need
# pseudo-terminals, and it makes its host keys on the first connection
# and keeps them in /etc/dropbear, which persists on an NFS root. Keys
# go in /root/.ssh/authorized_keys; no password is set.
if [ -x /usr/sbin/dropbear ]; then
	/bin/busybox mkdir -p /dev/pts /etc/dropbear
	/bin/busybox mount -t devpts devpts /dev/pts
	/usr/sbin/dropbear -R && echo "txhdl: dropbear is listening on 22"
fi
# `txhdl.ptycheck` logs in to this machine's own ssh server over the
# loopback and asks for a pseudo-terminal, the path an interactive
# login takes, which the model's peer cannot: it speaks no ssh.
if [ -n "$ptycheck" ] && [ -x /usr/bin/dbclient ]; then
	/bin/busybox ip link set lo up
	/usr/bin/dropbearkey -t ed25519 -f /root/ptycheck >/dev/null 2>&1
	/bin/busybox mkdir -p /root/.ssh
	/usr/bin/dropbearkey -y -f /root/ptycheck |
		/bin/busybox grep '^ssh-' >>/root/.ssh/authorized_keys
	# The client sets its own terminal raw, so it runs on one of its
	# own, which `script` gives it.
	/bin/busybox script -q -c "/usr/bin/dbclient -y -t \
		-i /root/ptycheck root@127.0.0.1 \
		'echo txhdl: a pty session ran on \$(tty)'" /dev/null </dev/null
	echo "txhdl: the pty check ended with $?"
fi
# `txhdl.applets` runs BusyBox applets that keep their state behind a
# pointer they set at the start, which clang once read before it was
# set: awk and netstat died of it (issue 1585).
if [ -n "$applets" ]; then
	echo "txhdl: awk said $(echo 1 2 | /bin/busybox awk '{print $2}')"
	/bin/busybox netstat -tln >/dev/null && echo "txhdl: netstat ran"
fi
# `txhdl.demo` is the console demo (issue 1592), the last of the
# steps above, so that its closing line is the last before the prompt:
# a fixed list of commands, each shown as `# <command>` and then its
# output, on the serial port and on the screen, with a pause of two
# seconds after each so a recording can follow it, or of N with
# `txhdl.demo=N`. The screen's shell starts after it, so the screen
# shows the list alone.
if [ -n "$demo" ]; then
	screen=/dev/null
	[ -c /dev/tty1 ] && screen=/dev/tty1
	for cmd in "uname -a" "cat /proc/cpuinfo" "nproc" "free" "ip addr" \
		"/bin/dynhello" ${peer:+"ping -c 3 -W 5 $peer"}; do
		echo "# $cmd" | /bin/busybox tee "$screen"
		/bin/busybox sh -c "$cmd" 2>&1 | /bin/busybox tee "$screen"
		/bin/busybox sleep "$demo"
	done
	echo "txhdl: demo done" | /bin/busybox tee "$screen"
fi
# A shell on the screen too, when there is one (issue 1440): the
# framebuffer console's first terminal, so a prompt shows on HDMI. Its
# input waits for a keyboard, or for ssh; the serial port's shell below
# is the one to type at.
if [ -c /dev/tty1 ]; then
	/bin/busybox setsid /bin/busybox sh -c \
		'exec /bin/busybox sh </dev/tty1 >/dev/tty1 2>&1' &
fi
# The shell takes the console as its controlling tty, so that Ctrl-C
# reaches the command in the foreground: with a plain exec it had none,
# said "can't access tty", and a command that hung at the board's
# console could not be stopped (issue 1249). Only a session leader can
# take one, and this is process 1, which leads its process group and so
# cannot start a session, so the shell runs in a session of its own,
# where cttyhack opens the console's tty for it. Process 1 must not
# exit, so it waits for the shell, and starts another if it ends.
while :; do
	/bin/busybox setsid /bin/busybox cttyhack /bin/sh
done
