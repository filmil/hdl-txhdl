# SPDX-License-Identifier: Apache-2.0
# Over the kernel's rv32_defconfig, what this machine is (issue 1008):
# one hart, no floating point and no vector unit, no loadable modules,
# SiFive's serial port as the console (issue 1011), a root filesystem
# in an initramfs, and no debug information, which only makes the
# build slower here.
CONFIG_SMP=n
CONFIG_MODULES=n
CONFIG_FPU=n
CONFIG_RISCV_ISA_V=n
CONFIG_SERIAL_SIFIVE=y
CONFIG_SERIAL_SIFIVE_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEBUG_INFO_NONE=y
# Trimmed (issue 1008): subsystems with no hardware on this board, which
# the rv32 defconfig builds in for the virt machine and others. They
# make up most of the defconfig's 34 MiB.
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_PCI=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_HID_SUPPORT=n
CONFIG_BTRFS_FS=n
CONFIG_NFS_FS=n
CONFIG_BPF_SYSCALL=n
CONFIG_FTRACE=n
