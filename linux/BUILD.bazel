# Linux on Vreteno (issue 279): the mainline kernel and OpenSBI, built
# with the hermetic LLVM from sources pinned by checksum, and nothing of
# the system's but the shell's own commands (issue 1008).
#
# The probe of M1: whether both build for this core with no GCC, and
# how big they are against the 16 MiB fastboot loads. Both are manual,
# since a kernel is many minutes of work:
#
#   bazel build //linux:kernel //linux:opensbi
#
# The kernel is `tinyconfig` with `vreteno.config` over it: only what
# this machine has (issue 1074).
load("@rules_rust//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "build.sh",
    "userspace.sh",
])

_TOOLS = [
    "build.sh",
    "userspace.sh",
    "@kbuild_tree//:all",
    "@llvm_toolchain_llvm//:bin",
    "@llvm_toolchain_llvm//:lib",
    "@llvm_toolchain_llvm//:include",
    "@sysroot_bullseye//tree:sysroot",
    "@python_3_12_host//:python",
]

# The trees' files; build.sh finds where each begins from them.
_ENV = " ".join([
    "KBUILD_FILES='$(execpaths @kbuild_tree//:all)'",
    "LLVM_FILES='$(execpaths @llvm_toolchain_llvm//:bin)'",
    "SYSROOT=$(execpath @sysroot_bullseye//tree:sysroot)",
    "PYTHON3=$(execpath @python_3_12_host//:python)",
])

genrule(
    name = "kernel",
    srcs = [
        "@linux//:src",
        "vreteno.config",
    ],
    outs = [
        "Image",
        "kernel.config",
        "System.map",
    ],
    cmd = _ENV + " $(execpath build.sh) kernel $(execpath @linux//:src) " +
          "$(execpath vreteno.config) $(execpath Image) " +
          "$(execpath kernel.config) " +
          "$(execpath System.map)",
    tags = ["manual"],
    tools = _TOOLS,
)

genrule(
    name = "opensbi",
    srcs = ["@opensbi//:src"],
    outs = [
        "fw_jump.bin",
        "fw_jump.elf",
    ],
    cmd = _ENV + " $(execpath build.sh) opensbi $(execpath @opensbi//:src) " +
          "$(execpath fw_jump.bin) $(execpath fw_jump.elf)",
    tags = ["manual"],
    tools = _TOOLS,
)

# The userspace (issue 1018): BusyBox on musl, static, for rv32imac at the
# soft-float ABI, and an initramfs that holds it, built with the same
# LLVM by userspace.sh. Manual, as the kernel is:
#
#   bazel build //linux:initramfs
#
# The sysroot: musl, the kernel's interface headers, and compiler-rt's
# builtins and start and end objects for the core, as one tar.
genrule(
    name = "rv32_sysroot",
    srcs = [
        "@compiler_rt//:src",
        "@linux//:src",
        "@musl//:src",
    ],
    outs = ["rv32_sysroot.tar"],
    cmd = _ENV + " $(execpath userspace.sh) sysroot " +
          "$(execpath @compiler_rt//:src) $(execpath @musl//:src) " +
          "$(execpath @linux//:src) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

# BusyBox, its defconfig with busybox.config over it, and the whole
# configuration it was built with.
genrule(
    name = "busybox",
    srcs = [
        ":rv32_sysroot",
        "@busybox//:src",
        "busybox.config",
    ],
    outs = [
        "bin/busybox",
        "busybox.full.config",
    ],
    cmd = _ENV + " $(execpath userspace.sh) busybox " +
          "$(execpath :rv32_sysroot) $(execpath @busybox//:src) " +
          "$(execpath busybox.config) $(execpath bin/busybox) " +
          "$(execpath busybox.full.config)",
    tags = ["manual"],
    tools = _TOOLS,
)

# The initramfs: BusyBox, /bin/sh linked to it, the console and null
# devices, and `init`, packed by the kernel's own gen_init_cpio.
genrule(
    name = "initramfs",
    srcs = [
        "bin/busybox",
        "init",
        "@linux//:src",
    ],
    outs = ["initramfs.cpio"],
    cmd = _ENV + " $(execpath userspace.sh) initramfs " +
          "$(execpath bin/busybox) $(execpath init) $(execpath @linux//:src) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

# What the initramfs holds, read back from the archive: every entry a
# boot needs, as what it should be, and BusyBox a static program for the
# core. Manual, since it builds the userspace; booting it is M9's model.
rust_test(
    name = "initramfs_test",
    srcs = ["initramfs_test.rs"],
    data = ["initramfs.cpio"],
    edition = "2021",
    env = {"INITRAMFS": "$(rootpath initramfs.cpio)"},
    tags = ["manual"],
)
