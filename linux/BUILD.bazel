# SPDX-License-Identifier: Apache-2.0
# Linux on Vreteno (issue 279): the mainline kernel and OpenSBI, built
# with the hermetic LLVM from sources pinned by checksum, and nothing of
# the system's but the shell's own commands (issue 1008).
#
# The probe of M1: whether both build for this core with no GCC, and
# how big they are against the 16 MiB fastboot loads. Both are manual,
# since a kernel is many minutes of work:
#
#   bazel build //linux:kernel //linux:opensbi
#
# The kernel is `tinyconfig` with `vreteno.config` over it: only what
# this machine has (issue 1074).
load("@rules_rust//rust:defs.bzl", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools/bootimg:defs.bzl", "boot_image")

package(default_visibility = ["//visibility:public"])

exports_files([
    "build.sh",
    "userspace.sh",
])

_TOOLS = [
    "build.sh",
    "userspace.sh",
    "@kbuild_tree//:all",
    "@llvm_toolchain_llvm//:bin",
    "@llvm_toolchain_llvm//:lib",
    "@llvm_toolchain_llvm//:include",
    "@sysroot_bullseye//tree:sysroot",
    "@python_3_12_host//:python",
]

# The trees' files; build.sh finds where each begins from them.
_ENV = " ".join([
    "KBUILD_FILES='$(execpaths @kbuild_tree//:all)'",
    "LLVM_FILES='$(execpaths @llvm_toolchain_llvm//:bin)'",
    "SYSROOT=$(execpath @sysroot_bullseye//tree:sysroot)",
    "PYTHON3=$(execpath @python_3_12_host//:python)",
])

genrule(
    name = "kernel",
    srcs = [
        "@linux//:src",
        "vreteno.config",
    ],
    outs = [
        "Image",
        "kernel.config",
        "System.map",
    ],
    cmd = _ENV + " $(execpath build.sh) kernel $(execpath @linux//:src) " +
          "$(execpath vreteno.config) $(execpath Image) " +
          "$(execpath kernel.config) " +
          "$(execpath System.map)",
    tags = ["manual"],
    tools = _TOOLS,
)

genrule(
    name = "opensbi",
    srcs = ["@opensbi//:src"],
    outs = [
        "fw_jump.bin",
        "fw_jump.elf",
    ],
    cmd = _ENV + " $(execpath build.sh) opensbi $(execpath @opensbi//:src) " +
          "$(execpath fw_jump.bin) $(execpath fw_jump.elf)",
    tags = ["manual"],
    tools = _TOOLS,
)

# The userspace (issue 1018): BusyBox on musl, static, for rv32imac at the
# soft-float ABI, and an initramfs that holds it, built with the same
# LLVM by userspace.sh. Manual, as the kernel is:
#
#   bazel build //linux:initramfs
#
# The sysroot: musl, the kernel's interface headers, and compiler-rt's
# builtins and start and end objects for the core, as one tar.
genrule(
    name = "rv32_sysroot",
    srcs = [
        "@compiler_rt//:src",
        "@linux//:src",
        "@musl//:src",
    ],
    outs = ["rv32_sysroot.tar"],
    cmd = _ENV + " $(execpath userspace.sh) sysroot " +
          "$(execpath @compiler_rt//:src) $(execpath @musl//:src) " +
          "$(execpath @linux//:src) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

# BusyBox, its defconfig with busybox.config over it, and the whole
# configuration it was built with.
genrule(
    name = "busybox",
    srcs = [
        ":rv32_sysroot",
        "@busybox//:src",
        "busybox.config",
    ],
    outs = [
        "bin/busybox",
        "busybox.full.config",
    ],
    cmd = _ENV + " $(execpath userspace.sh) busybox " +
          "$(execpath :rv32_sysroot) $(execpath @busybox//:src) " +
          "$(execpath busybox.config) $(execpath bin/busybox) " +
          "$(execpath busybox.full.config)",
    tags = ["manual"],
    tools = _TOOLS,
)

# Dropbear, the ssh server, and a program that shows a dynamic link
# works, both against musl's shared library, which the root carries at
# /lib/libc.so with the loader's name linked to it (issue 1439).
genrule(
    name = "dropbear",
    srcs = [
        ":rv32_sysroot",
        "@dropbear//:src",
    ],
    outs = ["bin/dropbearmulti"],
    cmd = _ENV + " $(execpath userspace.sh) dropbear " +
          "$(execpath :rv32_sysroot) $(execpath @dropbear//:src) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

# Two threads counting on the two harts (issue 1408), static, for the
# initramfs, whose /init runs it.
genrule(
    name = "smpcount",
    srcs = [
        ":rv32_sysroot",
        "smpcount.c",
    ],
    outs = ["bin/smpcount"],
    cmd = _ENV + " $(execpath userspace.sh) staticprog " +
          "$(execpath :rv32_sysroot) $(execpath smpcount.c) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

genrule(
    name = "dynhello",
    srcs = [
        ":rv32_sysroot",
        "dynhello.c",
    ],
    outs = ["bin/dynhello"],
    cmd = _ENV + " $(execpath userspace.sh) dynprog " +
          "$(execpath :rv32_sysroot) $(execpath dynhello.c) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

genrule(
    name = "musl_so",
    srcs = [":rv32_sysroot"],
    outs = ["lib/libc.so"],
    cmd = _ENV + " $(execpath userspace.sh) musl_so " +
          "$(execpath :rv32_sysroot) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

# The initramfs: BusyBox, /bin/sh linked to it, the console and null
# devices, and `init`, packed by the kernel's own gen_init_cpio.
genrule(
    name = "initramfs",
    srcs = [
        "bin/busybox",
        "bin/smpcount",
        "init",
        "@linux//:src",
    ],
    outs = ["initramfs.cpio"],
    cmd = _ENV + " $(execpath userspace.sh) initramfs " +
          "$(execpath bin/busybox) $(execpath init) $(execpath @linux//:src) " +
          "$(execpath bin/smpcount) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

# What the initramfs holds, read back from the archive: every entry a
# boot needs, as what it should be, and BusyBox a static program for the
# core. Manual, since it builds the userspace; booting it is M9's model.
rust_test(
    name = "initramfs_test",
    srcs = ["initramfs_test.rs"],
    data = ["initramfs.cpio"],
    edition = "2021",
    env = {"INITRAMFS": "$(rootpath initramfs.cpio)"},
    tags = ["manual"],
)

# The kernel, OpenSBI and the initramfs above as one image for the
# machine model, mem=64M, and the boot on it to BusyBox's prompt (issue
# 1016, M9). Manual, since it builds the kernel and the userspace and
# boots for a few minutes; the nightly linux workflow runs it.
#
#   bazel test //linux:boot_test
boot_image(
    name = "model_boot",
    bootargs = "earlycon console=tty0 console=ttySIF0",
    # As the board's: the console on the scanout's frame too, which
    # the machine's --screen shows (issue 1440).
    framebuffer = "0x42000000",
    initramfs = "initramfs.cpio",
    kernel = "Image",
    model = True,
    opensbi = "fw_jump.bin",
    system_map = "System.map",
    tags = ["manual"],
)

# The same for the board (M12, issue 1020): earlycon
# console=ttySIF0, and all of the board's gigabyte, so no mem=64M.
# Its eth0 comes up at 192.168.1.50/24, the address the fastboot
# server has, beside srv's 192.168.1.1, so the board is on its network
# with no commands typed (issue 1318). Fastboot takes it whole:
#
#   bazel build //linux:board_boot
#   fastboot -s tcp:192.168.1.50 boot bazel-bin/linux/board_boot.bin
boot_image(
    name = "board_boot",
    # The log on HDMI as well, through the simple framebuffer the shim
    # shows (issue 1440); /dev/console, the last named, stays the serial
    # port, where the input is.
    bootargs = "earlycon console=tty0 console=ttySIF0 txhdl.ip=192.168.1.50/24",
    framebuffer = "0x42000000",
    initramfs = "initramfs.cpio",
    kernel = "Image",
    opensbi = "fw_jump.bin",
    system_map = "System.map",
    tags = ["manual"],
)

# The board with its root on NFS from srv (issue 1438): the address
# from the kernel's own command line, so no DHCP server is needed, the
# root at srv's export, and an initramfs with nothing to run, so the
# kernel mounts that root and runs its /init. The tree for the export
# is nfs_root.tar, the initramfs's system, unpacked as root on srv with
# `tar -xpf` into /srv/vreteno-root. board_boot stays the fallback.
#
#   bazel build //linux:board_nfs_boot //linux:nfs_root_tar
#   fastboot -s tcp:192.168.1.50 boot bazel-bin/linux/board_nfs_boot.bin
genrule(
    name = "nfs_initramfs",
    srcs = ["@linux//:src"],
    outs = ["nfs_initramfs.cpio"],
    cmd = _ENV + " $(execpath userspace.sh) nfsboot " +
          "$(execpath @linux//:src) $@",
    tags = ["manual"],
    tools = _TOOLS,
)

genrule(
    name = "nfs_root_tar",
    srcs = [
        "bin/busybox",
        "bin/dropbearmulti",
        "bin/dynhello",
        "init",
        "lib/libc.so",
    ],
    outs = [
        "nfs_root.tar",
        "root.cpio",
    ],
    cmd = _ENV + " $(execpath userspace.sh) roottar " +
          "$(execpath bin/busybox) $(execpath init) " +
          "$(execpath lib/libc.so) $(execpath bin/dropbearmulti) " +
          "$(execpath bin/dynhello) $(execpath nfs_root.tar) " +
          "$(execpath root.cpio)",
    tags = ["manual"],
    tools = _TOOLS,
)

# What that tree holds: the initramfs's system, every entry root's.
rust_test(
    name = "nfs_root_test",
    srcs = ["nfs_root_test.rs"],
    data = ["nfs_root.tar"],
    edition = "2021",
    env = {"NFS_ROOT": "$(rootpath nfs_root.tar)"},
    tags = ["manual"],
)

boot_image(
    name = "board_nfs_boot",
    bootargs = "earlycon console=ttySIF0 root=/dev/nfs " +
               "nfsroot=192.168.1.1:/srv/vreteno-root,v3,tcp " +
               "ip=192.168.1.50::192.168.1.1:255.255.255.0:vreteno:eth0:off " +
               "rw init=/init",
    initramfs = "nfs_initramfs.cpio",
    kernel = "Image",
    opensbi = "fw_jump.bin",
    system_map = "System.map",
    tags = ["manual"],
)

sh_test(
    name = "boot_test",
    size = "large",
    srcs = ["boot_test.sh"],
    args = [
        "$(rootpath //cpu/vreteno:machine)",
        "$(rootpath :model_boot)",
    ],
    data = [
        ":model_boot",
        "//cpu/vreteno:machine",
    ],
    # The kernel brings up the second hart (issue 1408).
    env = {"EXPECT": "smp: Brought up 1 node, 2 CPUs"},
    tags = ["manual"],
)

# The same with the serial port as the loader leaves it on the board:
# its receive interrupt on and a byte waiting, which the interrupt
# controller holds as a request until the boot shim drains it. Without
# the drain the SiFive driver's probe takes it before the port exists
# and panics, as it did on the board (issue 1136).
sh_test(
    name = "boot_loaded_test",
    size = "large",
    srcs = ["boot_test.sh"],
    args = [
        "$(rootpath //cpu/vreteno:machine)",
        "$(rootpath :model_boot)",
        "--as-loaded",
        "x",
    ],
    data = [
        ":model_boot",
        "//cpu/vreteno:machine",
    ],
    tags = ["manual"],
)

# The network on the machine model (issue 1203): the model image with
# txhdl.net on its command line, so /init sets up eth0 and pings the
# peer the machine's --eth-peer puts on the cable. A reply is Linux's
# own litex_liteeth driving the port's registers and slots.
boot_image(
    name = "model_net_boot",
    bootargs = "earlycon console=ttySIF0 txhdl.net",
    initramfs = "initramfs.cpio",
    kernel = "Image",
    model = True,
    opensbi = "fw_jump.bin",
    system_map = "System.map",
    tags = ["manual"],
)

sh_test(
    name = "boot_net_test",
    size = "large",
    srcs = ["boot_test.sh"],
    args = [
        "$(rootpath //cpu/vreteno:machine)",
        "$(rootpath :model_net_boot)",
        "--eth-peer",
    ],
    data = [
        ":model_net_boot",
        "//cpu/vreteno:machine",
    ],
    # Three pings a second apart: each after the first waits on alarm(),
    # and a second of the model's time is 100 million instructions
    # (issue 1246).
    env = {
        "EXPECT": "txhdl: network is up",
        "STEPS": "500000000",
    },
    tags = ["manual"],
)

# The root the board mounts over NFS, as an initramfs for the model,
# which has no NFS server (issue 1439): musl's shared library, a dynamic
# program that says it ran, and Dropbear listening. A login over ssh is
# the board's check, since the model's peer speaks no ssh.
boot_image(
    name = "model_root_boot",
    initramfs = "root.cpio",
    kernel = "Image",
    model = True,
    opensbi = "fw_jump.bin",
    system_map = "System.map",
    tags = ["manual"],
)

sh_test(
    name = "boot_root_test",
    size = "large",
    srcs = ["boot_test.sh"],
    args = [
        "$(rootpath //cpu/vreteno:machine)",
        "$(rootpath :model_root_boot)",
    ],
    data = [
        ":model_root_boot",
        "//cpu/vreteno:machine",
    ],
    env = {
        "EXPECT": "txhdl: a dynamic program ran",
        "EXPECT_ALSO": "txhdl: dropbear is listening on 22",
    },
    tags = ["manual"],
)

# The words the board's image takes, on the machine model (issue 1318):
# txhdl.ip brings eth0 up at an address and txhdl.ping pings a host, as
# txhdl.net does with the model's two. The board carries
# txhdl.ip=192.168.1.50/24; the model's peer answers only 10.0.0.2, so
# the model shows the same words at its own addresses.
boot_image(
    name = "model_ip_boot",
    bootargs = "earlycon console=ttySIF0 " +
               "txhdl.ip=10.0.0.1/24 txhdl.ping=10.0.0.2",
    initramfs = "initramfs.cpio",
    kernel = "Image",
    model = True,
    opensbi = "fw_jump.bin",
    system_map = "System.map",
    tags = ["manual"],
)

sh_test(
    name = "boot_ip_test",
    size = "large",
    srcs = ["boot_test.sh"],
    args = [
        "$(rootpath //cpu/vreteno:machine)",
        "$(rootpath :model_ip_boot)",
        "--eth-peer",
    ],
    data = [
        ":model_ip_boot",
        "//cpu/vreteno:machine",
    ],
    env = {
        "EXPECT": "txhdl: network is up",
        "STEPS": "500000000",
    },
    tags = ["manual"],
)
