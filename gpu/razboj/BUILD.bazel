# SPDX-License-Identifier: Apache-2.0
# Razboj, a minimal GPU in TxHDL: a rasteriser that reads a display list and
# writes pixels into memory over AXI, the framebuffer behind the bus,
# and the demonstration that renders a scene and shows it.
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools/vivado:defs.bzl", "vivado_place_and_route2", "vivado_synthesis2")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "razboj",
    srcs = [
        "src/dl.rs",
        "src/fb.rs",
        "src/image.rs",
        "src/lib.rs",
        "src/model.rs",
        "src/op.rs",
        "src/raster.rs",
        "src/scene.rs",
        "src/sim.rs",
        "src/tiles.rs",
    ],
    crate_name = "razboj",
    edition = "2021",
    deps = [
        ":tile",
        "//lib:txhdl",
        "//lib/parts:txhdl_parts",
    ],
    proc_macro_deps = ["//lib:txhdl_macros"],
)

# Razboj's display list in tiles, for the CPU: the tile table and the
# binning (issue 1157). No standard library, so that a Vreteno program
# can use it as the tests do.
rust_library(
    name = "tile",
    srcs = ["tile/lib.rs"],
    crate_name = "razboj_tile",
    edition = "2021",
)

rust_test(
    name = "tile_test",
    crate = ":tile",
    edition = "2021",
)

# The sources by name, for the documents' listings.
filegroup(
    name = "sources",
    srcs = glob(["src/*.rs"]) + ["tile/lib.rs"],
)

# Render the scene and show it:  bazel run //gpu/razboj:demo
rust_binary(
    name = "demo",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":razboj",
        "//lib:txhdl",
    ],
)

# The traced run, small enough to draw and to replay:
#   bazel run //gpu/razboj:trace
rust_binary(
    name = "trace",
    srcs = ["src/trace.rs"],
    edition = "2021",
    deps = [
        ":razboj",
        "//lib:txhdl",
    ],
)

# The hardware against the model, pixel by pixel.
# Two lists one after the other, traced, with the rasteriser's netlist
# (issue 982).
rust_binary(
    name = "trace_lists",
    srcs = ["src/trace_lists.rs"],
    edition = "2021",
    deps = [
        ":razboj",
        "//lib:txhdl",
    ],
)

rust_test(
    name = "razboj_test",
    crate = ":razboj",
    edition = "2021",
)

# The rasteriser with the board's parameters, as Verilog (issue 984).
rust_binary(
    name = "netlist",
    srcs = ["src/bin/netlist.rs"],
    edition = "2021",
    deps = [":razboj"],
)

genrule(
    name = "razboj_v",
    outs = ["razboj.v"],
    cmd = "$(location :netlist) > $@",
    tools = [":netlist"],
)

# Razboj through Vivado, out of context: its ports are the partition's
# pins and not pads, the constraints name the clock and nothing else,
# so the bitstream is a stub and the reports are the point, as for the
# core (//cpu/vreteno:vreteno_pnr). Manual, so `//...` leaves them
# out, and tagged vivado_ci for the Vivado CI job of issue 1030.
#
#   bazel build //gpu/razboj:razboj_pnr
filegroup(
    name = "razboj_xdc",
    srcs = ["razboj.xdc"],
)

vivado_synthesis2(
    name = "razboj_synth",
    srcs = [":razboj_v"],
    part = "xc7a200tfbg484-2",
    synth_design_options = "-mode out_of_context",
    top = "razboj",
    xdcs = [":razboj_xdc"],
    tags = [
        "manual",
        "vivado_ci",
    ],
)

vivado_place_and_route2(
    name = "razboj_pnr",
    placeholder_bitstream = True,
    synthesis = ":razboj_synth",
    xdcs = [":razboj_xdc"],
    tags = [
        "manual",
        "vivado_ci",
    ],
)
