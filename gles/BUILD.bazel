# SPDX-License-Identifier: Apache-2.0
# GL ES 1.1 Common-Lite for Razboj: the fixed-point pipeline from a
# vertex to Razboj's display list, with no standard library so that a
# Vreteno program links it (docs/gles.md, issue 1159, #995).
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "gles",
    srcs = [
        "src/emit.rs",
        "src/fixed.rs",
        "src/gl.rs",
        "src/lib.rs",
        "src/light.rs",
        "src/matrix.rs",
    ],
    crate_name = "gles",
    edition = "2021",
    deps = ["//gpu/razboj:tile"],
)

rust_test(
    name = "gles_test",
    crate = ":gles",
    edition = "2021",
)

# The pipeline against references, through Razboj's model: the words
# against Razboj's encoder, the pictures against a pipeline in 128 bits,
# pixel for pixel, and the window against floating point.
rust_test(
    name = "model_test",
    srcs = ["tests/model.rs"],
    edition = "2021",
    deps = [
        ":gles",
        "//gpu/razboj",
        "//gpu/razboj:tile",
    ],
)

# Lighting against floating point: the sum at a vertex, and lit
# triangles through the pipeline (issue 1164).
rust_test(
    name = "light_test",
    srcs = ["tests/light.rs"],
    edition = "2021",
    deps = [
        ":gles",
        "//gpu/razboj",
        "//gpu/razboj:tile",
    ],
)

# The C entry points (issue 1224): extern "C" functions with the names
# and types Khronos's GLES/gl.h declares, over the library, so that a C
# program includes <GLES/gl.h> and links :gles_c. The library alone,
# for a Rust program on Vreteno; the same as a static library with the
# standard library, for a C program on the host.
rust_library(
    name = "capi",
    srcs = ["capi/lib.rs"],
    crate_name = "gles_capi",
    edition = "2021",
    deps = [
        ":gles",
        "//gpu/razboj:tile",
    ],
)

rust_static_library(
    name = "capi_static",
    srcs = ["capi/lib.rs"],
    crate_features = ["std"],
    crate_name = "gles_capi",
    edition = "2021",
    deps = [
        ":gles",
        "//gpu/razboj:tile",
    ],
)

# The entry points gl.h declares and capi/lib.rs does not define, as C
# that sets GL_INVALID_OPERATION, written from gl.h itself.
genrule(
    name = "capi_stubs",
    srcs = [
        "//third_party/khronos:GLES/gl.h",
        "capi/lib.rs",
    ],
    outs = ["capi/stubs.c"],
    cmd = "$(location capi/stubs.sh) $(location //third_party/khronos:GLES/gl.h) $(location capi/lib.rs) > $@",
    tools = ["capi/stubs.sh"],
)

cc_library(
    name = "gles_c",
    srcs = ["capi/stubs.c"],
    copts = ["-std=c11"],
    deps = [
        ":capi_static",
        "//third_party/khronos:gles1",
    ],
)
