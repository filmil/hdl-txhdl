# SPDX-License-Identifier: Apache-2.0
"""A tree of unpacked Debian packages, fetched by checksum.

OpenROAD and Yosys are published as Debian packages, and a Debian
package names the shared libraries it needs but does not carry them.
`//tools/debclosure` writes the closure of a package as a lock file,
one row per package with its checksum and two URLs; `deb_tree` reads
such a lock file and unpacks every package named in it into one
repository, which is then the root of a small filesystem that those
two tools can run against.

Nothing on the machine is used to do it. Bazel's own decompressors
open both an `ar` archive (a `.deb` is one) and the `tar.xz` inside
it, so the rule needs neither `dpkg` nor `ar` nor a container.
"""

def _rows(ctx, lock):
    """The lock file's data rows, each already split into its columns."""
    rows = []
    for line in ctx.read(lock).splitlines():
        if line.startswith("#") or not line.strip():
            continue
        cols = line.split("\t")
        if len(cols) == 5:
            # A file that is already immutable where it lies has no
            # second place to look, and its row stops at five columns.
            cols = cols + [""]
        if len(cols) != 6:
            fail("%s: a row must have five or six columns, got %d: %s" %
                 (lock, len(cols), line))
        rows.append(cols)
    return rows

def _urls(url, fallback):
    """The places to fetch from, the mirror that never forgets last.

    A row whose sixth column is empty names one place, which is what a
    file that is already immutable at its first URL wants.
    """
    if fallback:
        return [url, fallback]
    return [url]

def _deb_tree_impl(ctx):
    names = []
    for lock in ctx.attr.locks:
        for name, _version, _size, sha256, url, fallback in _rows(ctx, lock):
            names.append(name)

            # A `.deb` is an `ar` archive of three members, and the
            # files are in the second tar inside it, so the unpacking
            # is done twice: once into a scratch directory of this
            # package's own, and then from there into the tree every
            # package shares.
            scratch = "unpack/" + name
            ctx.download(
                url = _urls(url, fallback),
                output = scratch + "/pkg.deb",
                sha256 = sha256,
            )
            ctx.extract(scratch + "/pkg.deb", output = scratch, type = "deb")
            data = None
            for suffix in [".xz", ".gz", ".zst", ""]:
                candidate = scratch + "/data.tar" + suffix
                if ctx.path(candidate).exists:
                    data = candidate
                    break
            if data == None:
                fail("%s: no data tar inside the package" % name)
            ctx.extract(data, output = "tree")
            ctx.delete(scratch)
    ctx.delete("unpack")

    # Debian packages carry a few paths that a build cannot walk. The
    # X11 package puts a symlink to its own directory in it, which is
    # a cycle, and another that points at a file in /etc, which is not
    # there. Documentation and translations are simply weight.
    for path in ctx.attr.prune:
        ctx.delete("tree/" + path)

    ctx.file("BUILD.bazel", _BUILD.replace("NAMES", ", ".join(sorted(names))))

_BUILD = '''# SPDX-License-Identifier: Apache-2.0
# Generated by //third_party/debs:repo.bzl. The packages unpacked here
# are: NAMES.
package(default_visibility = ["//visibility:public"])

# Every file, because a program reaches for its own pieces by path at
# run time and naming them one by one would be a list that went stale.
filegroup(
    name = "all",
    srcs = glob(["tree/**"], exclude = ["**/BUILD*"]),
)
'''

deb_tree = repository_rule(
    implementation = _deb_tree_impl,
    doc = "Unpacks the Debian packages named in lock files into one tree.",
    attrs = {
        "locks": attr.label_list(
            allow_files = True,
            mandatory = True,
            doc = "Lock files written by //tools/debclosure.",
        ),
        "prune": attr.string_list(
            default = [
                "usr/bin/X11",
                "usr/share/X11/rgb.txt",
                "usr/share/doc",
                "usr/share/locale",
                "usr/share/man",
            ],
            doc = "Paths under the tree to delete after unpacking.",
        ),
    },
)

def _file_tree_impl(ctx):
    for lock in ctx.attr.locks:
        for path, _version, _size, sha256, url, fallback in _rows(ctx, lock):
            ctx.download(
                url = _urls(url, fallback),
                output = "tree/" + path,
                sha256 = sha256,
            )
    ctx.file("BUILD.bazel", ctx.attr.build_file_content)

file_tree = repository_rule(
    implementation = _file_tree_impl,
    doc = """Fetches single files by checksum into one tree.

    The lock file has the same six columns as a Debian one, so that
    the two kinds of pin read alike; the first column is the path the
    file takes in the tree rather than a package name, and the second
    is whatever names the version upstream.
    """,
    attrs = {
        "locks": attr.label_list(allow_files = True, mandatory = True),
        "build_file_content": attr.string(mandatory = True),
    },
)
