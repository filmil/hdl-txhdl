# SPDX-License-Identifier: Apache-2.0
# The mainline kernel's source, as one directory: the build reads it
# with `make -C ... O=...` and writes nothing into it, and a directory is
# one input to sandbox rather than ninety thousand (issue 1008).
filegroup(
    name = "src",
    srcs = ["."],
    visibility = ["//visibility:public"],
)
