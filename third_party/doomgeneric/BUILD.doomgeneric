# SPDX-License-Identifier: Apache-2.0
# doomgeneric as fetched (issue 1177): the game's sources, as its own
# Makefile lists them, less its platforms, which are the program's: a
# platform is `DG_Init`, `DG_DrawFrame`, `DG_SleepMs`, `DG_GetTicksMs`,
# `DG_GetKey` and `DG_SetWindowTitle`. GPL-2.0, as is what links it.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["restricted"])

GAME = [
    "dummy",
    "am_map",
    "doomdef",
    "doomstat",
    "dstrings",
    "d_event",
    "d_items",
    "d_iwad",
    "d_loop",
    "d_main",
    "d_mode",
    "d_net",
    "f_finale",
    "f_wipe",
    "g_game",
    "hu_lib",
    "hu_stuff",
    "info",
    "i_cdmus",
    "i_endoom",
    "i_joystick",
    "i_scale",
    "i_sound",
    "i_system",
    "i_timer",
    "memio",
    "m_argv",
    "m_bbox",
    "m_cheat",
    "m_config",
    "m_controls",
    "m_fixed",
    "m_menu",
    "m_misc",
    "m_random",
    "p_ceilng",
    "p_doors",
    "p_enemy",
    "p_floor",
    "p_inter",
    "p_lights",
    "p_map",
    "p_maputl",
    "p_mobj",
    "p_plats",
    "p_pspr",
    "p_saveg",
    "p_setup",
    "p_sight",
    "p_spec",
    "p_switch",
    "p_telept",
    "p_tick",
    "p_user",
    "r_bsp",
    "r_data",
    "r_draw",
    "r_main",
    "r_plane",
    "r_segs",
    "r_sky",
    "r_things",
    "sha1",
    "sounds",
    "statdump",
    "st_lib",
    "st_stuff",
    "s_sound",
    "tables",
    "v_video",
    "wi_stuff",
    "w_checksum",
    "w_file",
    "w_main",
    "w_wad",
    "z_zone",
    "w_file_stdc",
    "i_input",
    "i_video",
    "doomgeneric",
]

# The game's C sources and headers, for a build of them for the core.
filegroup(
    name = "srcs",
    srcs = ["doomgeneric/" + f + ".c" for f in GAME],
)

filegroup(
    name = "hdrs",
    srcs = glob(["doomgeneric/*.h"]),
)

# The game for the host, against a platform the program gives.
cc_library(
    name = "game",
    srcs = [":srcs"],
    hdrs = [":hdrs"],
    copts = [
        "-w",
        "-DNORMALUNIX",
        "-D_DEFAULT_SOURCE",
    ],
    includes = ["doomgeneric"],
)
