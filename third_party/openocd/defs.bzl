"""OpenOCD from its pinned tree, as an executable.

The tree is Debian's package and its closure, the C library among them,
since the build machine's is older than the one the package is built
against. So the binary is run through the tree's own dynamic loader with
the tree's libraries, as //tools/pdfedge runs `pdftotext`, and OpenOCD is
told where the tree's scripts are, since the path it was built with,
`/usr/share/openocd/scripts`, is not on the machine.

`openocd_binary` writes a script that does that. It finds the tree among
its runfiles, so it works under `bazel run` and as a data dependency of a
test alike, and it passes its arguments on.
"""

def _rlocation(f):
    """The path of `f` under a runfiles root."""
    if f.short_path.startswith("../"):
        return f.short_path[len("../"):]
    return "_main/" + f.short_path

def _openocd_binary_impl(ctx):
    files = ctx.attr.tree[DefaultInfo].files.to_list()
    binary = None
    for f in files:
        if f.short_path.endswith("/usr/bin/openocd"):
            binary = f
    if binary == None:
        fail("no usr/bin/openocd in %s" % ctx.attr.tree.label)
    root = _rlocation(binary)[:-len("/usr/bin/openocd")]
    script = ctx.actions.declare_file(ctx.label.name)
    ctx.actions.write(
        output = script,
        is_executable = True,
        content = "\n".join([
            "#!/usr/bin/env bash",
            "# Generated by //third_party/openocd:defs.bzl.",
            "set -euo pipefail",
            'r="${RUNFILES_DIR:-$0.runfiles}"',
            't="$r/%s"' % root,
            'exec "$t/usr/lib64/ld-linux-x86-64.so.2" \\',
            '    --library-path "$t/usr/lib/x86_64-linux-gnu" \\',
            '    "$t/usr/bin/openocd" -s "$t/usr/share/openocd/scripts" "$@"',
            "",
        ]),
    )
    return [DefaultInfo(
        executable = script,
        runfiles = ctx.runfiles(files = files),
    )]

openocd_binary = rule(
    implementation = _openocd_binary_impl,
    executable = True,
    doc = "OpenOCD from a pinned tree, run with the tree's own loader.",
    attrs = {
        "tree": attr.label(mandatory = True, doc = "The unpacked tree."),
    },
)
