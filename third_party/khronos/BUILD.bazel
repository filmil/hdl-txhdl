# SPDX-License-Identifier: Apache-2.0
# Khronos's OpenGL ES 1.1 headers, as MODULE.bazel fetches them, laid
# out where `#include <GLES/gl.h>` finds them (issue 1224). The files
# are Khronos's, under the MIT licence their own headers state.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

[
    genrule(
        name = "place_" + name,
        srcs = [src],
        outs = [out],
        cmd = "cp $< $@",
    )
    for name, src, out in [
        ("gl_h", "@khronos_gles_gl_h//file", "GLES/gl.h"),
        ("glplatform_h", "@khronos_gles_glplatform_h//file", "GLES/glplatform.h"),
        ("khrplatform_h", "@khronos_khrplatform_h//file", "KHR/khrplatform.h"),
    ]
]

cc_library(
    name = "gles1",
    hdrs = [
        "GLES/gl.h",
        "GLES/glplatform.h",
        "KHR/khrplatform.h",
    ],
    includes = ["."],
)
