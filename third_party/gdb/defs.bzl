"""gdb-multiarch from its pinned tree, as an executable.

The tree is Debian's package and its closure, the C library and Python
among them. As //third_party/openocd does for OpenOCD, the binary is run
through the tree's own dynamic loader with the tree's libraries. gdb is
told where its data directory is, and its Python where its standard
library is, since the paths both were built with, under `/usr`, are not
on the machine.

`gdb_binary` writes a script that does that. It finds the tree among its
runfiles, so it works under `bazel run` and as a data dependency of a
test alike, and it passes its arguments on.
"""

def _rlocation(f):
    """The path of `f` under a runfiles root."""
    if f.short_path.startswith("../"):
        return f.short_path[len("../"):]
    return "_main/" + f.short_path

def _gdb_binary_impl(ctx):
    files = ctx.attr.tree[DefaultInfo].files.to_list()
    binary = None
    for f in files:
        if f.short_path.endswith("/usr/bin/gdb-multiarch"):
            binary = f
    if binary == None:
        fail("no usr/bin/gdb-multiarch in %s" % ctx.attr.tree.label)
    root = _rlocation(binary)[:-len("/usr/bin/gdb-multiarch")]
    script = ctx.actions.declare_file(ctx.label.name)
    ctx.actions.write(
        output = script,
        is_executable = True,
        content = "\n".join([
            "#!/usr/bin/env bash",
            "# Generated by //third_party/gdb:defs.bzl.",
            "set -euo pipefail",
            'r="${RUNFILES_DIR:-$0.runfiles}"',
            't="$r/%s"' % root,
            'export PYTHONHOME="$t/usr"',
            'exec "$t/usr/lib64/ld-linux-x86-64.so.2" \\',
            '    --library-path "$t/usr/lib/x86_64-linux-gnu" \\',
            '    "$t/usr/bin/gdb-multiarch" \\',
            '    --data-directory "$t/usr/share/gdb" "$@"',
            "",
        ]),
    )
    return [DefaultInfo(
        executable = script,
        runfiles = ctx.runfiles(files = files),
    )]

gdb_binary = rule(
    implementation = _gdb_binary_impl,
    executable = True,
    doc = "gdb-multiarch from a pinned tree, run with the tree's own loader.",
    attrs = {
        "tree": attr.label(mandatory = True, doc = "The unpacked tree."),
    },
)
