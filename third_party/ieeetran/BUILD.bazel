package(default_visibility = ["//visibility:public"])

# Listed rather than globbed. A vendored tree should say exactly which files
# it ships, so a file added by accident does not travel with the next build.
filegroup(
    name = "files",
    srcs = [
        "IEEEtran.cls",
        "IEEEtrantools.sty",
    ],
)
